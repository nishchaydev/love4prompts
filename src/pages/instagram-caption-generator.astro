---
import Layout from '../components/layout/Layout.astro';
import { CaptionMaker } from '../components/tools/CaptionMaker';

const title = "Free AI Instagram Caption Generator | Love4Prompts";
const description = "Generate engaging Instagram captions with perfectly crafted hashtags and formatting using our free AI prompt toolkit.";
---

<Layout title={title} description={description} theme="editorial">
  <div class="w-full min-h-screen relative">
    <CaptionMaker client:load />
  </div>
</Layout>
