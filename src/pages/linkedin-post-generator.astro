---
import Layout from '../components/layout/Layout.astro';
import { LinkedInPostGenerator } from '../components/tools/LinkedInPostGenerator';
import { ToolsCTA } from '../components/seo/ToolsCTA';
---

<Layout title="LinkedIn Post Generator | love4prompts" 
  description="Generate viral LinkedIn posts in seconds. Choose your tone, hook style, and topic — AI writes the perfect post for you." theme="editorial">
  
  <div class="relative w-full min-h-screen overflow-hidden font-['Inter'] pt-20">
    <div class="relative z-10 container mx-auto max-w-[1200px] grid grid-cols-1 md:grid-cols-12 border-l border-[#cfc4c5] min-h-[calc(100vh-80px)]">

      {/* Row 1: Left Spacer | Header */}
      <div class="hidden md:block md:col-span-3 lg:col-span-2 border-r border-[#cfc4c5] relative overflow-visible bg-transparent">
        <div class="p-8 sticky top-24 h-full flex flex-col justify-between">
          {/* Rotated TOOLS title reading bottom to top, T at top, centered in sidebar */}
          <h1
            class="absolute top-[200px] left-[20px] xl:left-[50px] text-[180px] lg:text-[240px] leading-[0.75] font-black tracking-tighter text-black uppercase opacity-[0.07] hover:opacity-[0.15] transition-opacity m-0 pointer-events-none z-0"
            style="transform-origin: top left; transform: rotate(-90deg) translate(-100%, 0);"
          >
            TOOLS
          </h1>
        </div>
      </div>

      {/* Right Content Area */}
      <div class="md:col-span-9 lg:col-span-10 flex flex-col gap-16 p-6 lg:p-16 pb-32 w-full">
        <!-- Hero header -->
        <div class="text-center mb-0 flex flex-col items-start text-left">
          <div class="inline-flex items-center gap-2 px-4 py-2 bg-[#1482A3] text-white rounded-full font-bold tracking-widest text-[12px] uppercase mb-6 shadow-[4px_4px_0_#000] border-2 border-black">
            LINKEDIN POST GENERATOR
          </div>
          <h1 class="text-black font-black uppercase tracking-tighter text-4xl md:text-6xl leading-[1] mb-6 max-w-4xl">
            Write posts that actually get seen.
          </h1>
          <p class="text-[#4c4546] font-bold text-lg md:text-xl max-w-2xl leading-tight">
            Fill in the details, hit generate. Your next viral LinkedIn post takes 10 seconds.
          </p>
        </div>

        <!-- Tool component -->
        <LinkedInPostGenerator client:load />
        <ToolsCTA client:visible />

      </div>
    </div>
  </div>
</Layout>
