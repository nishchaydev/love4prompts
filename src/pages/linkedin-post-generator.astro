---
import Layout from '../components/layout/Layout.astro';
import { LinkedInPostGenerator } from '../components/tools/LinkedInPostGenerator';
---

<Layout title="LinkedIn Post Generator | love4prompts" 
  description="Generate viral LinkedIn posts in seconds. Choose your tone, hook style, and topic — AI writes the perfect post for you." theme="editorial">
  
  <div class="min-h-screen pt-24 pb-16">
    
    <!-- Hero header -->
    <div class="text-center mb-12 px-6">
      <p class="text-xs font-semibold tracking-widest 
         text-[var(--color-primary)] mb-4">
        LINKEDIN POST GENERATOR
      </p>
      <h1 class="text-4xl md:text-5xl font-bold 
         text-[var(--color-text-primary)] mb-4">
        Write posts that actually get seen.
      </h1>
      <p class="text-[var(--color-text-secondary)] max-w-xl mx-auto">
        Fill in the details, hit generate. 
        Your next viral LinkedIn post takes 10 seconds.
      </p>
    </div>

    <!-- Tool component -->
    <LinkedInPostGenerator client:load />

  </div>
</Layout>
