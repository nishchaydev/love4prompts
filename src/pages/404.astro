---
import Layout from '../components/layout/Layout.astro';
import { AdSlot } from '../components/ads/AdSlot';
---

<Layout title="404 - Page Not Found | Love4Prompts">
  <div class="min-h-screen bg-white flex flex-col items-center justify-center pt-[100px] pb-12 px-4 relative overflow-hidden">
    
    {/* Decorative Background Grid */}
    <div class="absolute inset-0 z-0 pointer-events-none" style="background-image: radial-gradient(#000 1px, transparent 1px); background-size: 32px 32px; opacity: 0.1;"></div>

    <div class="relative z-10 w-full max-w-4xl flex flex-col items-center text-center">
      
      <h1 class="text-black uppercase font-black text-[64px] md:text-[96px] leading-none mb-2 drop-shadow-[4px_4px_0_#FF6D87]">
        404
      </h1>
      <h2 class="text-black font-black text-[24px] md:text-[32px] uppercase tracking-widest mb-8 bg-[#FFD166] border-[3px] border-black px-4 py-2 shadow-[4px_4px_0_#000] rotate-[-2deg]">
        CONNECTION LOST
      </h2>

      <p class="text-black font-medium text-[18px] md:text-[20px] mb-8 max-w-lg">
        The page you are looking for has been swallowed by the void. While our server attempts to find it, defend the terminal from bad prompts!
      </p>

      {/* Mini Game Container */}
      <div class="w-full max-w-[800px] bg-[#FAEFED] border-[4px] border-black rounded-[24px] p-4 shadow-[8px_8px_0_#000] mb-12 relative flex flex-col items-center">
        
        {/* Game UI / Instructions */}
        <div class="w-full flex justify-between items-center mb-4 px-2">
          <div class="font-black text-[14px] uppercase tracking-widest text-black bg-white border-[2px] border-black px-3 py-1 shadow-[2px_2px_0_#000]">
            Arrows/A&D to Move • Space to Shoot
          </div>
          <div class="flex gap-4">
            <div class="font-black text-[20px] uppercase text-[#1482A3]">
              Score: <span id="game-score">0</span>
            </div>
            <div class="font-black text-[20px] uppercase text-[#FF6D87]">
              Best: <span id="high-score">0</span>
            </div>
          </div>
        </div>

        {/* Canvas */}
        <canvas id="gameCanvas" width="760" height="400" class="w-full h-[400px] bg-white border-[3px] border-black rounded-[12px] shadow-inner cursor-pointer"></canvas>
        
        {/* Game Over Screen */}
        <div id="gameOverScreen" class="absolute inset-0 z-20 flex flex-col items-center justify-center bg-black/80 rounded-[20px] hidden">
          <h3 class="text-white font-black text-[48px] uppercase mb-4 drop-shadow-[4px_4px_0_#FF6D87]">GAME OVER</h3>
          <button id="restartBtn" class="magnetic-btn bg-[#06D6A0] text-black px-8 py-3 rounded-full font-black text-[18px] uppercase tracking-wide border-[3px] border-black shadow-[4px_4px_0_#000] hover:bg-[#FFD166] transition-all duration-300">
            Play Again
          </button>
        </div>
      </div>

      {/* Ad Slot directly below game */}
      <div class="w-full flex justify-center mb-12 relative z-20">
        <AdSlot type="leaderboard" client:idle />
      </div>

      {/* Go Back Home */}
      <a href="/" class="magnetic-btn bg-black text-white px-8 py-4 rounded-full font-black text-[18px] uppercase tracking-wide border-[3px] border-black shadow-[6px_6px_0_#FF6D87] hover:bg-white hover:text-black transition-all duration-300">
        Return to Safety
      </a>

    </div>
  </div>

  <script is:inline>
    document.addEventListener('DOMContentLoaded', () => {
      const canvas = document.getElementById('gameCanvas');
      const ctx = canvas.getContext('2d');
      const scoreElement = document.getElementById('game-score');
      const highScoreElement = document.getElementById('high-score');
      const gameOverScreen = document.getElementById('gameOverScreen');
      const restartBtn = document.getElementById('restartBtn');

      let isPlaying = false;
      let isGameOver = false;
      let score = 0;
      let highScore = localStorage.getItem('promptRunnerHighScore') || 0;
      let frames = 0;
      let shakeTime = 0;
      let gameSpeed = 4.5;
      let spawnTimer = 80;
      let animFrameId = null;
      
      const groundY = 350;

      // Player Object
      const player = {
        x: 50,
        y: groundY - 40,
        width: 40, height: 40,
        vy: 0,
        gravity: 0.6,
        jumpStrength: 11,
        isGrounded: true,
        canDoubleJump: true,
        color: '#FF6D87',
        draw() {
          ctx.fillStyle = this.color;
          ctx.fillRect(this.x, this.y, this.width, this.height);
          ctx.strokeStyle = '#000';
          ctx.lineWidth = 3;
          ctx.strokeRect(this.x, this.y, this.width, this.height);
          
          // Little eye to give it personality
          ctx.fillStyle = '#000';
          ctx.fillRect(this.x + 25, this.y + 10, 5, 5);
        },
        update() {
          this.vy += this.gravity;
          this.y += this.vy;
          
          if (this.y >= groundY - this.height) {
            this.y = groundY - this.height;
            this.vy = 0;
            this.isGrounded = true;
            this.canDoubleJump = true;
          } else {
            this.isGrounded = false;
          }
          this.draw();
        },
        jump() {
          if (this.isGrounded) {
            this.vy = -this.jumpStrength;
            this.isGrounded = false;
            spawnParticles(this.x + 20, this.y + 40, '#1482A3', 10);
          } else if (this.canDoubleJump) {
            this.vy = -this.jumpStrength;
            this.canDoubleJump = false;
            spawnParticles(this.x + 20, this.y + 40, '#FFD166', 15);
          }
        }
      };

      const obstacles = [];
      class Obstacle {
        constructor() {
          this.type = Math.random() < 0.5 ? '404' : (Math.random() < 0.5 ? 'BUG' : 'ERROR');
          this.width = this.type === '404' ? 60 : (this.type === 'ERROR' ? 80 : 40);
          this.height = this.type === '404' ? 60 : 40;
          this.x = canvas.width;
          this.y = groundY - this.height;
          this.color = this.type === '404' ? '#1482A3' : '#FFD166';
        }
        draw() {
          ctx.fillStyle = this.color;
          ctx.fillRect(this.x, this.y, this.width, this.height);
          ctx.strokeStyle = '#000'; ctx.lineWidth = 3;
          ctx.strokeRect(this.x, this.y, this.width, this.height);
          
          ctx.fillStyle = '#000';
          ctx.font = '900 16px Inter, sans-serif';
          ctx.textAlign = 'center';
          ctx.fillText(this.type, this.x + this.width / 2, this.y + this.height / 2 + 6);
        }
        update() {
          this.x -= gameSpeed;
          this.draw();
        }
      }

      const particles = [];
      class Particle {
        constructor(x, y, color) {
          this.x = x; this.y = y;
          this.size = Math.random() * 6 + 2;
          this.speedX = Math.random() * 4 - 2 - (gameSpeed * 0.5); // move left with game
          this.speedY = Math.random() * 4 - 2;
          this.color = color;
          this.life = 1.0;
          this.decay = Math.random() * 0.05 + 0.02;
        }
        update() {
          this.x += this.speedX; this.y += this.speedY;
          this.life -= this.decay;
          ctx.fillStyle = this.color;
          ctx.globalAlpha = Math.max(0, this.life);
          ctx.fillRect(this.x, this.y, this.size, this.size);
          ctx.globalAlpha = 1.0;
        }
      }

      function spawnParticles(x, y, color, count = 10) {
        for(let i=0; i<count; i++) particles.push(new Particle(x, y, color));
      }

      function drawGround() {
        ctx.fillStyle = '#000';
        ctx.fillRect(0, groundY, canvas.width, 4);
        
        // draw some moving ground lines for speed effect
        ctx.lineWidth = 2;
        ctx.strokeStyle = '#000';
        for(let i=0; i<10; i++) {
           let lx = ((frames * gameSpeed + i * 100) % canvas.width);
           ctx.beginPath();
           ctx.moveTo(canvas.width - lx, groundY + 10);
           ctx.lineTo(canvas.width - lx + 20, groundY + 10);
           ctx.stroke();
        }
      }

      function updateScore() {
        if(frames % 5 === 0) {
          score++;
          scoreElement.innerText = score;
          if (score > highScore) {
            highScore = score;
            localStorage.setItem('promptRunnerHighScore', highScore);
            highScoreElement.innerText = highScore;
          }
        }
      }

      function handleGameLogic() {
        gameSpeed += 0.001; // Slowly increase speed

        spawnTimer--;
        if (spawnTimer <= 0) {
          obstacles.push(new Obstacle());
          // Decreasing spawn timer based on gameSpeed to keep spacing somewhat consistent
          spawnTimer = Math.floor(Math.random() * 50 + (300 / gameSpeed));
        }

        for (let i = 0; i < obstacles.length; i++) {
          obstacles[i].update();

          // Collision Detection (with small forgiveness margin)
          const margin = 5;
          if (
            player.x + margin < obstacles[i].x + obstacles[i].width &&
            player.x + player.width - margin > obstacles[i].x &&
            player.y + margin < obstacles[i].y + obstacles[i].height &&
            player.y + player.height - margin > obstacles[i].y
          ) {
            shakeTime = 15;
            isGameOver = true;
            spawnParticles(player.x + player.width/2, player.y + player.height/2, player.color, 30);
          }
          
          if (obstacles[i].x + obstacles[i].width < 0) {
            obstacles.splice(i, 1);
            i--;
          }
        }

        // Dust particles while running
        if (player.isGrounded && frames % 5 === 0) {
          spawnParticles(player.x + 10, groundY, '#ccc', 2);
        }

        for (let i = 0; i < particles.length; i++) {
          particles[i].update();
          if (particles[i].life <= 0) { particles.splice(i, 1); i--; }
        }
      }

      function init() {
        obstacles.length = 0; particles.length = 0;
        score = 0; frames = 0; gameSpeed = 4.5; spawnTimer = 80;
        scoreElement.innerText = score;
        highScoreElement.innerText = highScore;
        isGameOver = false;
        player.y = groundY - player.height;
        player.vy = 0;
        gameOverScreen.classList.add('hidden');
        isPlaying = true;
        animate();
      }

      function animate() {
        if (isGameOver) {
          gameOverScreen.classList.remove('hidden');
          isPlaying = false;
          return;
        }

        ctx.save();
        if (shakeTime > 0) {
          const dx = Math.random() * 10 - 5;
          const dy = Math.random() * 10 - 5;
          ctx.translate(dx, dy);
          shakeTime--;
        }

        ctx.clearRect(0, 0, canvas.width, canvas.height);
        
        drawGround();
        handleGameLogic();
        player.update();
        updateScore();

        ctx.restore();

        frames++;
        animFrameId = requestAnimationFrame(animate);
      }

      function drawWaitingState() {
        ctx.clearRect(0, 0, canvas.width, canvas.height);
        drawGround();
        player.draw();
        ctx.fillStyle = '#000';
        ctx.font = '900 24px Inter, sans-serif';
        ctx.textAlign = 'center';
        ctx.fillText('TAP OR SPACE TO START', canvas.width / 2, canvas.height / 2 - 20);
        highScoreElement.innerText = highScore;
      }

      function handleAction(e) {
        if (e && e.type !== 'keydown') e.preventDefault();
        
        if (!isPlaying) {
          init();
        } else if (!isGameOver) {
          player.jump();
        }
      }

      const spaceHandler = (e) => {
        if (e.code === 'Space') {
          e.preventDefault();
          handleAction(e);
        }
      };

      window.addEventListener('keydown', spaceHandler);
      canvas.addEventListener('mousedown', handleAction);
      canvas.addEventListener('touchstart', handleAction, { passive: false });
      restartBtn.addEventListener('click', init);

      // Cleanup logic to prevent leaks on navigation
      document.addEventListener('astro:before-swap', () => {
        if (animFrameId) cancelAnimationFrame(animFrameId);
        window.removeEventListener('keydown', spaceHandler);
        if (canvas) {
          canvas.removeEventListener('mousedown', handleAction);
          canvas.removeEventListener('touchstart', handleAction);
        }
        if (restartBtn) restartBtn.removeEventListener('click', init);
      }, { once: true });

      drawWaitingState();
    });
  </script>
</Layout>
