---
import Layout from '../../components/layout/Layout.astro';
import { PromptDetailView } from '../../components/prompt/PromptDetailView';
import { supabase } from '../../lib/supabase';
import type { Prompt } from '../../components/library/PromptCard';
import { PromptCard } from '../../components/library/PromptCard';
import { mockPrompts } from '../../lib/mock-data';

const { slug } = Astro.params;

if (!slug) {
  return Astro.redirect('/404');
}

// Fetch prompt data
let { data: prompt, error } = await supabase
  .from('prompts')
  .select('*')
  .eq('slug', slug)
  .single();

// Fallback to mock data
if (error || !prompt) {
  const mockPrompt = mockPrompts.find(p => p.slug === slug);
  if (mockPrompt) {
    prompt = mockPrompt as any;
    error = null;
  }
}

if (error || !prompt) {
  return Astro.redirect('/404');
}

// Increment view count in background (only if it has an id from db)
if (typeof prompt.id === 'string' && !prompt.id.startsWith('mock-')) {
  supabase.rpc('increment_view_count', { row_id: prompt.id }).then();
}

const seoTitle = `${prompt.title} - Love4Prompts`;
const seoDescription = prompt.prompt_text.substring(0, 150) + '...';

// Get 4 random or related prompts for the CTA section
const relatedPrompts = mockPrompts.filter(p => p.id !== prompt?.id).slice(0, 4);
---

<Layout 
  title={seoTitle} 
  description={seoDescription}
  ogImage={prompt.image_url}
>
  <PromptDetailView 
    client:load 
    prompt={prompt as Prompt} 
  />

  {/* Related Trends Section */}
  <section class="border-t border-[var(--color-border)] py-16 px-5 sm:px-8">
    <div class="max-w-[1200px] mx-auto">
      <div class="flex justify-between items-end mb-10">
        <div>
          <h2 class="font-[Anton] uppercase text-[var(--color-text)] text-[28px] sm:text-[40px] leading-none mb-2">
            More Trends to Try
          </h2>
          <p class="text-[var(--color-text-muted)] text-[13px] font-[Epilogue]">
            Keep the inspiration flowing
          </p>
        </div>
        <a href="/library" class="hidden md:inline-flex items-center gap-2 px-5 py-2.5 rounded-full bg-[var(--color-bg-surface)] border border-[var(--color-border)] text-[var(--color-text-secondary)] hover:text-[var(--color-text)] hover:border-[var(--color-border-hover)] text-[13px] font-semibold transition-all no-underline cursor-pointer font-[Epilogue]">
          Explore All →
        </a>
      </div>
      
      <div class="grid grid-cols-2 lg:grid-cols-4 gap-4">
        {relatedPrompts.map((p, i) => (
          <PromptCard client:visible prompt={p as Prompt} index={i} />
        ))}
      </div>
    </div>
  </section>
</Layout>
