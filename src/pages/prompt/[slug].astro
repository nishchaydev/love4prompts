---
import Layout from '../../components/layout/Layout.astro';
import { PromptDetailView } from '../../components/prompt/PromptDetailView';
import { supabase } from '../../lib/supabase';
import type { Prompt } from '../../components/library/PromptCard';
import { PromptCard } from '../../components/library/PromptCard';
import { mockPrompts } from '../../lib/mock-data';

const { slug } = Astro.params;

if (!slug) {
  return Astro.redirect('/404');
}

// Fetch prompt data
let { data: prompt, error } = await supabase
  .from('prompts')
  .select('*')
  .eq('slug', slug)
  .single();

// Fallback to mock data
if (error || !prompt) {
  const mockPrompt = mockPrompts.find(p => p.slug === slug);
  if (mockPrompt) {
    prompt = mockPrompt as any;
    error = null;
  }
}

if (error || !prompt) {
  return Astro.redirect('/404');
}

// Increment view count in background (only if it has an id from db)
if (typeof prompt.id === 'string' && !prompt.id.startsWith('mock-')) {
  supabase.rpc('increment_view_count', { row_id: prompt.id }).then();
}

const seoTitle = `${prompt.title} - Love4Prompts`;
const seoDescription = prompt.prompt_text.substring(0, 150) + '...';

// Get 4 random or related prompts for the CTA section
const relatedPrompts = mockPrompts.filter(p => p.id !== prompt?.id).slice(0, 4);
---

<Layout 
  title={seoTitle} 
  description={seoDescription}
  ogImage={prompt.image_url}
  theme="editorial"
>
  <PromptDetailView 
    client:load 
    prompt={prompt as Prompt} 
  />

  {/* CTA / More Prompts Section */}
  <section class="bg-[#fafafa] border-t border-black py-16 px-4 md:px-8">
    <div class="max-w-7xl mx-auto">
      <div class="flex justify-between items-end mb-8">
        <div>
          <h2 class="text-black uppercase font-black text-3xl md:text-5xl leading-none tracking-tighter mb-2">
            More to Explore
          </h2>
          <p class="text-[#4c4546] uppercase font-bold tracking-widest text-sm">
            Keep the inspiration flowing
          </p>
        </div>
        <a href="/library" class="hidden md:inline-block border-2 border-black bg-white text-black font-bold uppercase tracking-widest text-sm px-6 py-3 rounded-full hover:bg-black hover:text-white transition-colors shadow-[4px_4px_0_#000] hover:shadow-none">
          View Library
        </a>
      </div>
      
      <div class="grid grid-cols-2 sm:grid-cols-2 lg:grid-cols-4 gap-4 md:gap-6">
        {relatedPrompts.map(p => (
          <PromptCard client:visible prompt={p as Prompt} />
        ))}
      </div>
    </div>
  </section>
</Layout>

<style>
  .fill-icon {
    font-variation-settings: 'FILL' 1;
  }
</style>
