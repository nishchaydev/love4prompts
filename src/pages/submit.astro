---
import Layout from '../components/layout/Layout.astro';
import { DashboardClient } from '../components/profile/DashboardClient';

const title = "Dashboard - Love4Prompts";
const description = "Manage your saved AI prompts and extract new ones from Instagram Reels.";
---

<Layout title={title} description={description} theme="editorial">
  <div className="w-full min-h-screen bg-[#f9f9f9] relative">
    <DashboardClient client:only="react" />
  </div>
</Layout>
