---
import Layout from '../components/layout/Layout.astro';

const title = "Non-User Notice | Love4Prompts";
const description = "Important notice for non-registered users browsing Love4Prompts.";
---

<Layout title={title} description={description}>
  <div class="max-w-4xl mx-auto px-6 py-24 text-black relative z-10 font-['Inter']">
    <div class="mb-12 border-b-8 border-black pb-8">
      <h1 class="text-5xl sm:text-7xl font-black tracking-tighter mb-4 text-black uppercase">Non-User Notice</h1>
      <p class="text-[#FF6D87] text-lg font-bold uppercase tracking-widest bg-black inline-block px-4 py-2">Last updated: June 2026</p>
    </div>

    <div class="space-y-12">
      <section class="space-y-4 bg-white border-4 border-black p-6 sm:p-10 shadow-[8px_8px_0_#1482A3] hover:shadow-[12px_12px_0_#FF6D87] hover:-translate-y-1 hover:-translate-x-1 transition-all duration-300">
        <h2 class="text-3xl font-black tracking-tight text-black uppercase">Browsing as a Guest</h2>
        <p class="text-gray-800 font-medium leading-relaxed text-lg">
          You are currently browsing love4prompts as an unregistered user. While you are free to explore our prompt library and use some of our basic tools, creating an account unlocks the full potential of our platform, including saving prompts, managing your library, and accessing advanced features.
        </p>
      </section>

      <section class="space-y-4 bg-white border-4 border-black p-6 sm:p-10 shadow-[8px_8px_0_#1482A3] hover:shadow-[12px_12px_0_#FF6D87] hover:-translate-y-1 hover:-translate-x-1 transition-all duration-300">
        <h2 class="text-3xl font-black tracking-tight text-black uppercase">User Content Disclaimer</h2>
        <p class="text-gray-800 font-medium leading-relaxed text-lg">
          We do not take any guarantee of the content uploaded, submitted, or shared by users on our platform. The prompts and text you see are generated or shared by the community and are not endorsed by us. Please use your own discretion when interacting with or utilizing any user-generated content.
        </p>
      </section>

      <section class="space-y-4 bg-white border-4 border-black p-6 sm:p-10 shadow-[8px_8px_0_#1482A3] hover:shadow-[12px_12px_0_#FF6D87] hover:-translate-y-1 hover:-translate-x-1 transition-all duration-300">
        <h2 class="text-3xl font-black tracking-tight text-black uppercase">Data Collection</h2>
        <p class="text-gray-800 font-medium leading-relaxed text-lg">
          Even as a non-registered user, we may collect basic analytics and usage data to help us improve the site. For full details on what we collect and how it is used, please refer to our <a href="/privacy" class="text-black font-black border-b-4 border-[#FF6D87] hover:bg-[#FF6D87] hover:text-white transition-all">Privacy Policy</a>.
        </p>
      </section>
    </div>
  </div>
</Layout>
