---
import Layout from '../components/layout/Layout.astro';
import { UniversalBar } from '../components/hero/UniversalBar';
import { FeaturesGrid } from '../components/marketing/FeaturesGrid';
import { HowItWorks } from '../components/marketing/HowItWorks';
import { TestimonialSection } from '../components/marketing/TestimonialSection';

const title = "Free AI Coding Prompt Generator | Love4Prompts";
const description = "Generate perfectly structured coding prompts for Cursor, Copilot, ChatGPT, and Claude. Get bug-free code faster.";
---

<Layout title={title} description={description}>
  <div>
    <section class="flex flex-col items-center justify-center px-4 pt-20 sm:pt-28 pb-12 sm:pb-20 z-10 relative">
      <div class="flex flex-col items-center text-center gap-4 sm:gap-5 w-full max-w-[720px] mx-auto">
        <p class="text-[11px] font-mono font-bold text-[var(--color-primary)] uppercase tracking-[0.2em] mb-2">
          Coding Prompt Generator
        </p>
        <h1 class="text-[clamp(36px,6vw,60px)] font-light tracking-[-0.045em] leading-[1.05] text-white">
          Write better coding prompts.<br />
          <span class="text-white/30 font-light">Get bug-free code faster.</span>
        </h1>
        <p class="text-[15.5px] text-white/45 max-w-[460px] leading-relaxed font-medium">
          Describe the feature or bug, and our AI will generate a highly-structured, context-rich prompt ready for Cursor, Copilot, or Claude.
        </p>

        <div class="w-full mt-4">
          <UniversalBar client:load />
        </div>

        <div class="flex flex-wrap items-center justify-center gap-x-5 gap-y-2 text-[10px] sm:text-[11px] font-bold text-white/35 mt-2 font-mono uppercase tracking-wider">
          <span class="tabular-nums">6 tools</span>
          <span class="w-px h-3 bg-white/[0.06] hidden sm:block"></span>
          <span>Free</span>
          <span class="w-px h-3 bg-white/[0.06] hidden sm:block"></span>
          <span>No signup</span>
        </div>
      </div>
    </section>

    <FeaturesGrid client:visible />
    <HowItWorks client:visible />
    <TestimonialSection />
  </div>
</Layout>
