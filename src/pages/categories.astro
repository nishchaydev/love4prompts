---
import Layout from '../components/layout/Layout.astro';
import { supabase } from '../lib/supabase';
import { mockPrompts } from '../lib/mock-data';

const { data: dbPrompts, error } = await supabase
  .from('prompts')
  .select('*')
  .eq('is_public', true)
  .order('created_at', { ascending: false });

const prompts = dbPrompts && dbPrompts.length > 0 ? dbPrompts : mockPrompts;

const categories = [
  { 
    name: "Boys", 
    color: "#1482A3", 
    desc: "High-end supercar night shots, bold streetwear, and clean aesthetic poses.",
    subcategories: ["Cars", "Streetwear", "Aesthetic"]
  },
  { 
    name: "Girls", 
    color: "#FF6D87", 
    desc: "Sunset Parisian cafes, warm film aesthetics, and high-fidelity portraits.",
    subcategories: ["Cafe", "Portrait", "Paris"]
  },
  { 
    name: "Professional", 
    color: "#06D6A0", 
    desc: "Corporate headshots, navy blue tailored suits, and executive office profiles.",
    subcategories: ["Corporate", "Headshot", "Business"]
  },
  { 
    name: "AI art", 
    color: "#9b59b6", 
    desc: "Surreal bioluminescent forests, glass sculptures, and glowing fantasy aesthetics.",
    subcategories: ["Surreal", "3D Art", "Glowing"]
  },
  { 
    name: "Birthday", 
    color: "#FFD166", 
    desc: "Minimalist organic strawberry cakes, warm candlelight, and cozy party memories.",
    subcategories: ["Cake", "Celebration", "Party"]
  },
  { 
    name: "Festivals", 
    color: "#e67e22", 
    desc: "Sunsets, huge concerts, dancing crowds, laser lights, and festival energy.",
    subcategories: ["Sunset", "Concert", "Stage"]
  },
  { 
    name: "Posters", 
    color: "#1abc9c", 
    desc: "Swiss typography layouts, minimal posters, vector lines, and flat layouts.",
    subcategories: ["Swiss", "Typography", "Poster"]
  },
  { 
    name: "Netflix typo", 
    color: "#e74c3c", 
    desc: "Cinematic subtitle overlays, moody detective alleyways, and movie font edits.",
    subcategories: ["Netflix", "Cinematic", "Subtitle"]
  },
  { 
    name: "Memories", 
    color: "#34495e", 
    desc: "Nostalgic golden beach laughter, retro camera grain, and warm summer vintage vibes.",
    subcategories: ["Nostalgia", "Beach", "Golden Hour"]
  },
  { 
    name: "Anniversary", 
    color: "#FF3B30", 
    desc: "Candlelight private balcony dining, city skyline twilights, and elegant romance.",
    subcategories: ["Romantic", "Skyline", "Dinner"]
  }
];

const getCount = (catName: string) => prompts.filter((p: any) => p.category === catName).length;
---

<Layout title="Explore Trend Categories | Love4Prompts" 
  description="Browse viral AI image trends by category: Girls, Boys, Professional, AI art, Birthday, Festivals, Posters, Netflix typo, Memories, and Anniversary. Find the exact aesthetic you want to recreate.">
  
  <div class="flex flex-1 relative min-h-screen overflow-x-hidden">
    {/* Background Massive Text */}
    <div class="absolute inset-0 z-0 flex items-center justify-center pointer-events-none select-none overflow-hidden pt-20">
      <span 
        class="text-[#e8e8e8] font-bold tracking-tighter whitespace-nowrap" 
        style="font-size: clamp(80px, 20vw, 320px); line-height: 0.8;"
      >
        TOPICS
      </span>
    </div>

    <!-- Main Content -->
    <main class="w-full relative z-10 max-w-7xl mx-auto px-6 md:px-12 pt-24 pb-16">
      <div class="mb-16 flex flex-col">
        <div class="inline-flex items-center gap-2 px-4 py-2 bg-black text-white rounded-full font-bold tracking-widest text-[12px] uppercase mb-6 shadow-[4px_4px_0_#FF6D87] border-2 border-black self-start">
          Trend Index
        </div>
        <h1 class="text-black font-black uppercase tracking-tighter text-[48px] md:text-[72px] leading-[0.9] mb-4">
          Browse by <span class="text-[#FF6D87] drop-shadow-[2px_2px_0_#000]">Category</span>
        </h1>
        <p class="text-black font-medium text-[16px] sm:text-[20px] leading-relaxed max-w-2xl mb-0">
          Find your exact aesthetic from our curated collection of viral AI image trends. Select a category below or explore specific subcategories.
        </p>
      </div>

      {/* Categories Grid */}
      <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
        {categories.map((cat) => {
          const count = getCount(cat.name);
          return (
            <div 
              class="relative bg-white border-[4px] border-black rounded-[24px] p-6 sm:p-8 shadow-[8px_8px_0_#000] hover:-translate-y-1.5 hover:scale-[1.01] hover:shadow-[12px_12px_0_#FF6D87] active:scale-[0.99] transition-all duration-300 flex flex-col justify-between overflow-hidden group"
              style={`border-top-color: ${cat.color}; border-top-width: 8px;`}
            >
              {/* Top Section */}
              <div>
                <div class="flex justify-between items-start mb-6">
                  <div class="text-xs font-black uppercase tracking-widest text-gray-400">Topic</div>
                  <span 
                    class="border-2 border-black px-4 py-1.5 rounded-full font-black text-xs uppercase tracking-wider shadow-[2px_2px_0_#000] bg-white"
                    style={`color: ${cat.color}; border-color: ${cat.color};`}
                  >
                    {count} {count === 1 ? 'Trend' : 'Trends'}
                  </span>
                </div>
                
                <h2 class="text-black font-black uppercase text-2xl sm:text-3xl tracking-tight mb-3 group-hover:text-[#FF6D87] transition-colors">
                  {cat.name}
                </h2>
                
                <p class="text-gray-600 text-sm sm:text-base leading-relaxed mb-8">
                  {cat.desc}
                </p>
              </div>

              {/* Bottom Section - Subcategories */}
              <div>
                <div class="h-[2px] bg-black/10 w-full mb-6"></div>
                <h3 class="ed-label-caps text-[#4c4546] mb-3">Popular Aesthetics</h3>
                <div class="flex flex-wrap gap-2">
                  {cat.subcategories.map((sub) => (
                    <a 
                      href={`/library?q=${encodeURIComponent(sub)}`}
                      class="px-3.5 py-1.5 bg-[#f6f6f6] hover:bg-black hover:text-white border-2 border-black rounded-full text-xs font-bold transition-all hover:scale-105 active:scale-95"
                    >
                      #{sub}
                    </a>
                  ))}
                  <a 
                    href={`/library?category=${cat.name}`}
                    class="px-3.5 py-1.5 bg-black text-white hover:bg-[#FF6D87] border-2 border-black rounded-full text-xs font-bold transition-all hover:scale-105 active:scale-95"
                  >
                    View All {cat.name} →
                  </a>
                </div>
              </div>
            </div>
          );
        })}
      </div>
    </main>
  </div>
</Layout>
