---
import Layout from '../../components/layout/Layout.astro';
import { PromptToImage } from '../../components/tools/PromptToImage';
import { FAQSection } from '../../components/seo/FAQSection';

const faqs = [
  { question: "How does prompt-to-image work?", answer: "Type a text description and our tool generates an image in real-time using Pollinations AI. The image is rendered at 1024×1024 resolution and can be downloaded instantly." },
  { question: "Is prompt-to-image free?", answer: "Yes, completely free with unlimited generations. No API key, no signup, no rate limit." },
  { question: "Can I use the generated images commercially?", answer: "Images are generated by Pollinations AI. Check their terms for commercial use rights. We recommend reviewing Pollinations AI's license before commercial use." },
  { question: "What makes a good image prompt?", answer: "Be specific about subject, style, lighting, composition, and mood. For example: 'A futuristic cyberpunk city at night, neon lights reflecting on wet streets, cinematic lighting, ultra-detailed, 8K' works better than just 'a city at night'." },
];

const relatedTools = [
  { label: "Image to Prompt", href: "/tools/image-to-prompt" },
  { label: "Prompt Enhancer", href: "/tools/prompt-enhancer" },
  { label: "Prompt Maker", href: "/tools/prompt-maker" },
];
---

<Layout 
  title="Free AI Prompt to Image Generator — Create Images from Text" 
  description="Generate stunning images from text descriptions. Free AI image generator powered by Pollinations AI. No signup required."
>
  <PromptToImage client:load />
  <FAQSection client:visible faqs={faqs} relatedTools={relatedTools} />
</Layout>
