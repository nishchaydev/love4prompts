---
import Layout from '../../components/layout/Layout.astro';
import { ImageToPrompt } from '../../components/tools/ImageToPrompt';
import { FAQSection } from '../../components/seo/FAQSection';
import { ToolsCTA } from '../../components/seo/ToolsCTA';

const faqs = [
  { question: "How does image-to-prompt work?", answer: "Upload any image and our AI analyzes its composition, style, lighting, colors, subjects, and mood to generate a detailed text prompt that can recreate a similar image in Midjourney, DALL-E, Flux, or Stable Diffusion." },
  { question: "What image formats are supported?", answer: "JPEG, PNG, and WebP files up to 4MB. Images are automatically resized to 1024px max dimension for optimal analysis." },
  { question: "Can I use the generated prompt directly?", answer: "Yes — the output prompt is formatted for your selected target model and can be copied and pasted directly into Midjourney, DALL-E, or any other image AI." },
  { question: "Is my uploaded image stored?", answer: "No. Images are processed in-memory and not saved on our servers. Your uploads are never stored or shared." },
];

const relatedTools = [
  { label: "Prompt to Image", href: "/tools/prompt-to-image" },
  { label: "Prompt Enhancer", href: "/tools/prompt-enhancer" },

];
---

<Layout 
  title="Free Image to Prompt — Reverse Engineer Any Image into AI Prompt" 
  description="Upload any image and get a detailed AI prompt that can recreate it in Midjourney, DALL-E, Flux, or Stable Diffusion. Free reverse image-to-prompt tool."
>
  
  <div class="relative w-full min-h-screen overflow-hidden font-['Inter']">
    <div class="relative z-10 container mx-auto max-w-[1200px] border-l border-r border-[#cfc4c5] min-h-[calc(100vh-80px)]">

      {/* Full-width Hero Header */}
      <div class="col-span-1 md:col-span-12 px-6 lg:px-16 pt-8 lg:pt-10 pb-12 border-b border-[#cfc4c5]">
        <div class="inline-flex items-center gap-2 px-4 py-2 bg-[#1482A3] text-white rounded-full font-bold tracking-widest text-[12px] uppercase mb-6 shadow-[4px_4px_0_#000] border-2 border-black">
          IMAGE TO PROMPT
        </div>
        <h1 class="text-black font-black uppercase tracking-tighter text-5xl md:text-7xl leading-[0.9] mb-6 max-w-5xl">
          Reverse engineer any image.
        </h1>
        <p class="text-[#4c4546] font-bold text-xl md:text-2xl max-w-3xl leading-tight">
          Upload any image and get a detailed AI prompt that can recreate it in Midjourney, DALL-E, Flux, or Stable Diffusion.
        </p>
      </div>

      {/* Grid for Tool + Sidebar */}
      <div class="grid grid-cols-1 md:grid-cols-12">
        {/* Left Sidebar */}
        <div class="hidden md:block md:col-span-3 lg:col-span-2 border-r border-[#cfc4c5] relative overflow-visible bg-transparent min-h-[600px]">
          <div class="p-8 sticky top-24 h-full flex flex-col justify-between">
            {/* Rotated TOOLS title reading bottom to top, T at top, centered in sidebar */}
            <h1
              class="absolute top-[64px] left-[20px] xl:left-[50px] text-[180px] lg:text-[240px] leading-[0.75] font-black tracking-tighter text-black uppercase opacity-[0.07] hover:opacity-[0.15] transition-opacity m-0 pointer-events-none z-0"
              style="transform-origin: top left; transform: rotate(-90deg) translate(-100%, 0);"
            >
              TOOLS
            </h1>
          </div>
        </div>

        {/* Right Content Area */}
        <div class="md:col-span-9 lg:col-span-10 p-6 lg:p-16 w-full">
          <ImageToPrompt client:load />
        </div>
      </div>

      {/* Full-width Bottom Area */}
      <div class="px-6 lg:px-16 py-16 lg:py-24 border-t border-[#cfc4c5] flex flex-col gap-24">
        {/* Related Tools */}
        <div class="w-full max-w-6xl mx-auto">
          <p class="text-[14px] font-mono font-bold text-black/50 uppercase tracking-[0.2em] mb-8 text-center">
            Try also
          </p>
          <div class="flex flex-wrap justify-center gap-6">
            {relatedTools.map((tool) => (
              <a
                href={tool.href}
                class="flex-1 min-w-[280px] max-w-[350px] text-center px-8 py-6 rounded-2xl text-xl font-black uppercase tracking-tight border-[3px] border-black bg-white text-black shadow-[6px_6px_0_rgba(0,0,0,1)] hover:shadow-[10px_10px_0_rgba(0,0,0,1)] hover:-translate-y-1 hover:-translate-x-1 hover:bg-[#FF6D87] hover:text-white transition-all no-underline"
              >
                {tool.label} &rarr;
              </a>
            ))}
          </div>
        </div>
        <ToolsCTA />
        <FAQSection client:visible faqs={faqs} />
      </div>
    </div>
  </div>
</Layout>
