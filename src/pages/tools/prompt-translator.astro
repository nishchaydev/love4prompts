---
import Layout from '../../components/layout/Layout.astro';
import { PromptTranslator } from '../../components/tools/PromptTranslator';
import { FAQSection } from '../../components/seo/FAQSection';

const faqs = [
  { question: "What is a prompt translator?", answer: "A prompt translator converts prompts written for one AI platform into the correct format for another. For example, it can take a Midjourney prompt with --ar 16:9 flags and rewrite it for DALL-E using natural language descriptions." },
  { question: "Which AI platforms can I translate between?", answer: "You can translate prompts between ChatGPT, Midjourney, DALL-E, Claude, Gemini, Flux, and Stable Diffusion. The translator automatically adapts syntax, parameters, and model-specific conventions." },
  { question: "Will the meaning of my prompt change during translation?", answer: "No. Our AI preserves the core intent, subject matter, and creative direction of your prompt. It only changes the syntax, formatting, and platform-specific parameters to match the target AI." },
  { question: "Can I translate image prompts to text prompts?", answer: "Yes — for example, translating a Midjourney image prompt into a ChatGPT text prompt. The translator detects the modality shift and adapts accordingly." },
];

const relatedTools = [
  { label: "Prompt Enhancer", href: "/tools/prompt-enhancer" },
  { label: "Prompt Maker", href: "/tools/prompt-maker" },
  { label: "Prompt to Image", href: "/tools/prompt-to-image" },
];
---

<Layout 
  title="Free AI Prompt Translator — Convert Prompts Between AI Tools" 
  description="Translate prompts between ChatGPT, Midjourney, DALL-E, Claude, Gemini, and Flux. Convert any AI prompt to work on a different platform instantly."
 theme="editorial">
  <PromptTranslator client:load />
  <FAQSection client:visible faqs={faqs} relatedTools={relatedTools} />
</Layout>
