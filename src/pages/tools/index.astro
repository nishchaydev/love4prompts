---
import Layout from '../../components/layout/Layout.astro';
---

<Layout 
  title="Free AI Prompt Tools — Enhance, Generate, Translate & Reverse Engineer Prompts" 
  description="Powerful AI prompt tools. Enhance any prompt, generate from scratch, translate between AI tools, or reverse-engineer images into prompts. All free."
>
  <div class="relative pt-[120px] pb-[80px] px-4 overflow-hidden">
    <div class="container mx-auto max-w-[1000px] relative z-10">
      
      <!-- Hero -->
      <div class="text-center mb-16 animate-fade-in-up">
        <div class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full bg-[var(--color-accent-blue)]/10 border border-[var(--color-accent-blue)]/20 text-[var(--color-accent-blue)] text-sm font-bold mb-6 tracking-wide uppercase">
          <span class="relative flex h-2 w-2">
            <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-[var(--color-accent-blue)] opacity-75"></span>
            <span class="relative inline-flex rounded-full h-2 w-2 bg-[var(--color-accent-blue)]"></span>
          </span>
          Free AI Tools
        </div>
        <h1 class="text-[clamp(36px,8vw,68px)] leading-[1.1] font-black text-white tracking-tighter mb-4">
          AI Prompt Tools
        </h1>
        <p class="text-lg sm:text-xl text-[var(--color-text-secondary)] max-w-[600px] mx-auto leading-relaxed font-medium">
          Everything you need to craft, enhance, and convert AI prompts. Powered by Claude.
        </p>
      </div>

      <!-- Tools Grid -->
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-5" id="tools-grid">
        
        <!-- Prompt Enhancer -->
        <a href="/tools/prompt-enhancer" id="tool-enhancer" class="group relative flex flex-col p-8 rounded-3xl bg-[var(--color-background-card)] border border-white/[0.06] hover:border-[var(--color-primary)]/40 transition-all duration-300 hover:-translate-y-1 hover:shadow-[0_20px_60px_-15px_rgba(255,42,95,0.2)] no-underline">
          <div class="w-16 h-16 rounded-2xl bg-gradient-to-br from-[#ff2a5f] to-[#ff6b6b] flex items-center justify-center mb-6 shadow-[0_8px_25px_rgba(255,42,95,0.3)] group-hover:shadow-[0_8px_35px_rgba(255,42,95,0.5)] group-hover:scale-110 transition-all duration-300">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-7 h-7 text-white" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m21.64 3.64-1.28-1.28a1.21 1.21 0 0 0-1.72 0L2.36 18.64a1.21 1.21 0 0 0 0 1.72l1.28 1.28a1.2 1.2 0 0 0 1.72 0L21.64 5.36a1.2 1.2 0 0 0 0-1.72"/><path d="m14 7 3 3"/><path d="M5 6v4"/><path d="M19 14v4"/><path d="M10 2v2"/><path d="M7 8H3"/><path d="M21 16h-4"/><path d="M11 3H9"/></svg>
          </div>
          <h2 class="text-xl font-bold text-white mb-2 group-hover:text-[var(--color-primary)] transition-colors">Prompt Enhancer</h2>
          <p class="text-[var(--color-text-secondary)] text-sm leading-relaxed flex-1">Turn any basic prompt into a detailed, optimized prompt for your target AI tool.</p>
          <div class="mt-6 flex items-center gap-2 text-sm font-semibold text-[var(--color-text-muted)] group-hover:text-[var(--color-primary)] transition-colors">
            Use tool
            <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 transition-transform group-hover:translate-x-1" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
          </div>
        </a>

        <!-- Prompt Maker -->
        <a href="/tools/prompt-maker" id="tool-maker" class="group relative flex flex-col p-8 rounded-3xl bg-[var(--color-background-card)] border border-white/[0.06] hover:border-[var(--color-accent-blue)]/40 transition-all duration-300 hover:-translate-y-1 hover:shadow-[0_20px_60px_-15px_rgba(0,229,255,0.15)] no-underline">
          <div class="w-16 h-16 rounded-2xl bg-gradient-to-br from-[#00e5ff] to-[#0088ff] flex items-center justify-center mb-6 shadow-[0_8px_25px_rgba(0,229,255,0.3)] group-hover:shadow-[0_8px_35px_rgba(0,229,255,0.5)] group-hover:scale-110 transition-all duration-300">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-7 h-7 text-white" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M15 4V2"/><path d="M15 16v-2"/><path d="M8 9h2"/><path d="M20 9h2"/><path d="M17.8 11.8 19 13"/><path d="M15 9h.01"/><path d="M17.8 6.2 19 5"/><path d="m3 21 9-9"/><path d="M12.2 6.2 11 5"/></svg>
          </div>
          <h2 class="text-xl font-bold text-white mb-2 group-hover:text-[var(--color-accent-blue)] transition-colors">Prompt Maker</h2>
          <p class="text-[var(--color-text-secondary)] text-sm leading-relaxed flex-1">Describe your idea in plain English — get a ready-to-use AI prompt instantly.</p>
          <div class="mt-6 flex items-center gap-2 text-sm font-semibold text-[var(--color-text-muted)] group-hover:text-[var(--color-accent-blue)] transition-colors">
            Use tool
            <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 transition-transform group-hover:translate-x-1" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
          </div>
        </a>

        <!-- Prompt Translator -->
        <a href="/tools/prompt-translator" id="tool-translator" class="group relative flex flex-col p-8 rounded-3xl bg-[var(--color-background-card)] border border-white/[0.06] hover:border-[var(--color-accent-purple)]/40 transition-all duration-300 hover:-translate-y-1 hover:shadow-[0_20px_60px_-15px_rgba(138,43,226,0.15)] no-underline">
          <div class="w-16 h-16 rounded-2xl bg-gradient-to-br from-[#8a2be2] to-[#c060ff] flex items-center justify-center mb-6 shadow-[0_8px_25px_rgba(138,43,226,0.3)] group-hover:shadow-[0_8px_35px_rgba(138,43,226,0.5)] group-hover:scale-110 transition-all duration-300">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-7 h-7 text-white" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m16 3 4 4-4 4"/><path d="M20 7H4"/><path d="m8 21-4-4 4-4"/><path d="M4 17h16"/></svg>
          </div>
          <h2 class="text-xl font-bold text-white mb-2 group-hover:text-[var(--color-accent-purple)] transition-colors">Prompt Translator</h2>
          <p class="text-[var(--color-text-secondary)] text-sm leading-relaxed flex-1">Convert any prompt between AI tools — Midjourney to DALL-E, ChatGPT to Claude, and more.</p>
          <div class="mt-6 flex items-center gap-2 text-sm font-semibold text-[var(--color-text-muted)] group-hover:text-[var(--color-accent-purple)] transition-colors">
            Use tool
            <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 transition-transform group-hover:translate-x-1" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
          </div>
        </a>

        <!-- Image to Prompt -->
        <a href="/tools/image-to-prompt" id="tool-image-to-prompt" class="group relative flex flex-col p-8 rounded-3xl bg-[var(--color-background-card)] border border-white/[0.06] hover:border-[var(--color-success-green)]/40 transition-all duration-300 hover:-translate-y-1 hover:shadow-[0_20px_60px_-15px_rgba(16,185,129,0.15)] no-underline">
          <div class="w-16 h-16 rounded-2xl bg-gradient-to-br from-[#10b981] to-[#34d399] flex items-center justify-center mb-6 shadow-[0_8px_25px_rgba(16,185,129,0.3)] group-hover:shadow-[0_8px_35px_rgba(16,185,129,0.5)] group-hover:scale-110 transition-all duration-300">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-7 h-7 text-white" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="18" height="18" x="3" y="3" rx="2" ry="2"/><circle cx="9" cy="9" r="2"/><path d="m21 15-3.086-3.086a2 2 0 0 0-2.828 0L6 21"/></svg>
          </div>
          <h2 class="text-xl font-bold text-white mb-2 group-hover:text-[var(--color-success-green)] transition-colors">Image to Prompt</h2>
          <p class="text-[var(--color-text-secondary)] text-sm leading-relaxed flex-1">Upload any AI image and get the reverse-engineered prompt that could recreate it.</p>
          <div class="mt-6 flex items-center gap-2 text-sm font-semibold text-[var(--color-text-muted)] group-hover:text-[var(--color-success-green)] transition-colors">
            Use tool
            <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 transition-transform group-hover:translate-x-1" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
          </div>
        </a>

        <!-- Prompt to Image -->
        <a href="/tools/prompt-to-image" id="tool-prompt-to-image" class="group relative flex flex-col p-8 rounded-3xl bg-[var(--color-background-card)] border border-white/[0.06] hover:border-[#ff9a00]/40 transition-all duration-300 hover:-translate-y-1 hover:shadow-[0_20px_60px_-15px_rgba(255,154,0,0.15)] no-underline">
          <div class="w-16 h-16 rounded-2xl bg-gradient-to-br from-[#ff9a00] to-[#ff5200] flex items-center justify-center mb-6 shadow-[0_8px_25px_rgba(255,154,0,0.3)] group-hover:shadow-[0_8px_35px_rgba(255,154,0,0.5)] group-hover:scale-110 transition-all duration-300">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-7 h-7 text-white" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"/></svg>
          </div>
          <h2 class="text-xl font-bold text-white mb-2 group-hover:text-[#ff9a00] transition-colors">Prompt to Image</h2>
          <p class="text-[var(--color-text-secondary)] text-sm leading-relaxed flex-1">Generate stunning AI images instantly directly from your text descriptions.</p>
          <div class="mt-6 flex items-center gap-2 text-sm font-semibold text-[var(--color-text-muted)] group-hover:text-[#ff9a00] transition-colors">
            Use tool
            <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 transition-transform group-hover:translate-x-1" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
          </div>
        </a>

        <!-- LinkedIn Post Generator -->
        <a href="/linkedin-post-generator" id="tool-linkedin" class="group relative flex flex-col p-8 rounded-3xl bg-[var(--color-background-card)] border border-white/[0.06] hover:border-[#0a66c2]/40 transition-all duration-300 hover:-translate-y-1 hover:shadow-[0_20px_60px_-15px_rgba(10,102,194,0.15)] no-underline">
          <div class="w-16 h-16 rounded-2xl bg-gradient-to-br from-[#0a66c2] to-[#004182] flex items-center justify-center mb-6 shadow-[0_8px_25px_rgba(10,102,194,0.3)] group-hover:shadow-[0_8px_35px_rgba(10,102,194,0.5)] group-hover:scale-110 transition-all duration-300">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-7 h-7 text-white" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"/><rect width="4" height="12" x="2" y="9"/><circle cx="4" cy="4" r="2"/></svg>
          </div>
          <h2 class="text-xl font-bold text-white mb-2 group-hover:text-[#0a66c2] transition-colors">LinkedIn Post Generator</h2>
          <p class="text-[var(--color-text-secondary)] text-sm leading-relaxed flex-1">Write viral, highly-engaging LinkedIn posts instantly with formatting and hooks.</p>
          <div class="mt-6 flex items-center gap-2 text-sm font-semibold text-[var(--color-text-muted)] group-hover:text-[#0a66c2] transition-colors">
            Use tool
            <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 transition-transform group-hover:translate-x-1" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
          </div>
        </a>

        <!-- Instagram Caption Generator -->
        <a href="/instagram-caption-generator" id="tool-instagram" class="group relative flex flex-col p-8 rounded-3xl bg-[var(--color-background-card)] border border-white/[0.06] hover:border-[#e1306c]/40 transition-all duration-300 hover:-translate-y-1 hover:shadow-[0_20px_60px_-15px_rgba(225,48,108,0.15)] no-underline">
          <div class="w-16 h-16 rounded-2xl bg-gradient-to-br from-[#f58529] via-[#dd2a7b] to-[#8134af] flex items-center justify-center mb-6 shadow-[0_8px_25px_rgba(225,48,108,0.3)] group-hover:shadow-[0_8px_35px_rgba(225,48,108,0.5)] group-hover:scale-110 transition-all duration-300">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-7 h-7 text-white" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="20" height="20" x="2" y="2" rx="5" ry="5"/><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"/><line x1="17.5" x2="17.51" y1="6.5" y2="6.5"/></svg>
          </div>
          <h2 class="text-xl font-bold text-white mb-2 group-hover:text-[#e1306c] transition-colors">Insta Caption Generator</h2>
          <p class="text-[var(--color-text-secondary)] text-sm leading-relaxed flex-1">Generate engaging Instagram captions with perfectly crafted hashtags.</p>
          <div class="mt-6 flex items-center gap-2 text-sm font-semibold text-[var(--color-text-muted)] group-hover:text-[#e1306c] transition-colors">
            Use tool
            <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 transition-transform group-hover:translate-x-1" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
          </div>
        </a>

        <!-- Coding Prompt Generator -->
        <a href="/coding-prompt-generator" id="tool-coding" class="group relative flex flex-col p-8 rounded-3xl bg-[var(--color-background-card)] border border-white/[0.06] hover:border-[#10b981]/40 transition-all duration-300 hover:-translate-y-1 hover:shadow-[0_20px_60px_-15px_rgba(16,185,129,0.15)] no-underline">
          <div class="w-16 h-16 rounded-2xl bg-gradient-to-br from-[#059669] to-[#047857] flex items-center justify-center mb-6 shadow-[0_8px_25px_rgba(5,150,105,0.3)] group-hover:shadow-[0_8px_35px_rgba(5,150,105,0.5)] group-hover:scale-110 transition-all duration-300">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-7 h-7 text-white" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="16 18 22 12 16 6"/><polyline points="8 6 2 12 8 18"/></svg>
          </div>
          <h2 class="text-xl font-bold text-white mb-2 group-hover:text-[#10b981] transition-colors">Coding Prompt Generator</h2>
          <p class="text-[var(--color-text-secondary)] text-sm leading-relaxed flex-1">Generate perfectly structured coding prompts for Cursor, Copilot, and Claude.</p>
          <div class="mt-6 flex items-center gap-2 text-sm font-semibold text-[var(--color-text-muted)] group-hover:text-[#10b981] transition-colors">
            Use tool
            <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 transition-transform group-hover:translate-x-1" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
          </div>
        </a>

      </div>

      <!-- Bottom CTA -->
      <div class="text-center mt-16 animate-fade-in-up" style="animation-delay: 0.3s;">
        <p class="text-[var(--color-text-muted)] text-sm mb-4">Looking for ready-made prompts?</p>
        <a href="/#library" class="inline-flex items-center gap-2 px-6 py-3 rounded-full border border-white/10 bg-white/5 text-white text-sm font-bold hover:bg-white/10 hover:border-white/20 transition-all duration-300 no-underline">
          Browse Prompt Library
          <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
        </a>
      </div>

    </div>
  </div>
</Layout>
