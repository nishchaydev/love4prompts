---
import Layout from '../../components/layout/Layout.astro';
---

<Layout 
  title="Instruments — Love4Prompts" 
  description="Precision utilities for prompt engineering. Execute transformations, translate syntax, and generate concepts."
  theme="editorial"
>
  <div class="relative min-h-[85vh] bg-[#ffffff]">
    
    {/* Background Grid Pattern */}
    <div class="absolute inset-0 z-0 pointer-events-none opacity-[0.4]" 
         style="background-image: linear-gradient(to right, #cfc4c5 1px, transparent 1px), linear-gradient(to bottom, #cfc4c5 1px, transparent 1px); background-size: 40px 40px; background-position: center top;">
    </div>

    {/* Content Container */}
    <div class="relative z-10 max-w-[1200px] mx-auto px-[24px] sm:px-[40px] pt-[60px] sm:pt-[100px] pb-[120px]">
      
      {/* Header Section */}
      <div class="flex flex-col mb-[80px]">
        <div class="border-l-[4px] border-[#FF6D87] pl-[20px] sm:pl-[24px]">
          <div class="ed-label-caps text-[#4c4546] mb-[24px] tracking-[0.1em]">
            // SYSTEM.TOOLS.INDEX
          </div>
          <h1 class="text-black mb-[24px] tracking-tighter uppercase" 
              style="font-family: 'Inter', sans-serif; font-size: clamp(48px, 9vw, 110px); font-weight: 900; line-height: 0.9;">
            Tools<span class="text-[#FF6D87]">.</span>
          </h1>
          <p class="ed-body-main text-[#4c4546] max-w-[500px] mb-[16px]">
            Simple tools to help you write perfect prompts and create better AI images.
          </p>
          <p class="text-[#FF6D87] font-bold tracking-widest uppercase text-[12px]">
            Making your everyday simple!
          </p>
        </div>
      </div>

      {/* Grid of Tools */}
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-[1px] bg-black border border-black shadow-[8px_8px_0_#FF6D87]">
        
        {/* 01: ENHANCER */}
        <a href="/tools/prompt-enhancer" class="bg-white p-[40px] relative group flex flex-col h-[340px] transition-all duration-300 hover:shadow-[8px_8px_0_#FF6D87] hover:-translate-y-1 hover:-translate-x-1 cursor-pointer block no-underline">
          <div class="absolute top-[24px] right-[24px] ed-label-caps text-[#cfc4c5] font-mono group-hover:text-black transition-colors">01</div>
          <div class="w-[48px] h-[48px] border border-black flex items-center justify-center mb-[40px] bg-white transition-colors duration-300 group-hover:bg-[#FF6D87] group-hover:border-[#FF6D87]">
            <span class="material-symbols-outlined text-black group-hover:text-white transition-colors">auto_awesome</span>
          </div>
          <h2 class="text-black tracking-tighter uppercase font-black text-[24px] mb-[16px] leading-none">PROMPT ENHANCER</h2>
          <p class="ed-label-caps text-[10px] tracking-widest text-[#4c4546] mb-auto leading-relaxed">TURN SIMPLE IDEAS INTO DETAILED, PROFESSIONAL PROMPTS WITH ONE CLICK.</p>
          <div class="mt-auto pt-[24px] flex items-center gap-[8px] text-black font-bold tracking-widest text-[12px] group-hover:text-[#FF6D87] transition-colors">
            <span>START ENHANCING</span>
            <span class="material-symbols-outlined text-[16px] group-hover:translate-x-1 transition-transform">arrow_forward</span>
          </div>
        </a>

        {/* 02: MAKER */}
        <a href="/tools/prompt-maker" class="bg-white p-[40px] relative group flex flex-col h-[340px] transition-all duration-300 hover:shadow-[8px_8px_0_#FF6D87] hover:-translate-y-1 hover:-translate-x-1 cursor-pointer block no-underline">
          <div class="absolute top-[24px] right-[24px] ed-label-caps text-[#cfc4c5] font-mono group-hover:text-black transition-colors">02</div>
          <div class="w-[48px] h-[48px] border border-black flex items-center justify-center mb-[40px] bg-white transition-colors duration-300 group-hover:bg-[#FF6D87] group-hover:border-[#FF6D87]">
            <span class="material-symbols-outlined text-black group-hover:text-white transition-colors">build</span>
          </div>
          <h2 class="text-black tracking-tighter uppercase font-black text-[24px] mb-[16px] leading-none">PROMPT BUILDER</h2>
          <p class="ed-label-caps text-[10px] tracking-widest text-[#4c4546] mb-auto leading-relaxed">BUILD CUSTOM PROMPTS STEP-BY-STEP USING OUR EASY VISUAL CREATOR.</p>
          <div class="mt-auto pt-[24px] flex items-center gap-[8px] text-black font-bold tracking-widest text-[12px] group-hover:text-[#FF6D87] transition-colors">
            <span>START BUILDING</span>
            <span class="material-symbols-outlined text-[16px] group-hover:translate-x-1 transition-transform">arrow_forward</span>
          </div>
        </a>


        {/* 03: SOCIAL MEDIA AI */}
        <a href="/tools/social-media" class="bg-white p-[40px] relative group flex flex-col h-[340px] transition-all duration-300 hover:shadow-[8px_8px_0_#FF6D87] hover:-translate-y-1 hover:-translate-x-1 cursor-pointer block no-underline">
          <div class="absolute top-[24px] right-[24px] ed-label-caps text-[#cfc4c5] font-mono group-hover:text-black transition-colors">03</div>
          <div class="w-[48px] h-[48px] border border-black flex items-center justify-center mb-[40px] bg-white transition-colors duration-300 group-hover:bg-[#FF6D87] group-hover:border-[#FF6D87]">
            <span class="material-symbols-outlined text-black group-hover:text-white transition-colors">post_add</span>
          </div>
          <h2 class="text-black tracking-tighter uppercase font-black text-[24px] mb-[16px] leading-none">SOCIAL MEDIA AI</h2>
          <p class="ed-label-caps text-[10px] tracking-widest text-[#4c4546] mb-auto leading-relaxed">TURN A SIMPLE IDEA INTO A READY-TO-PUBLISH POST FOR LINKEDIN OR TWITTER.</p>
          <div class="mt-auto pt-[24px] flex items-center gap-[8px] text-black font-bold tracking-widest text-[12px] group-hover:text-[#FF6D87] transition-colors">
            <span>START WRITING</span>
            <span class="material-symbols-outlined text-[16px] group-hover:translate-x-1 transition-transform">arrow_forward</span>
          </div>
        </a>

        {/* 04: CAPTION MAKER */}
        <a href="/tools/caption-maker" class="bg-white p-[40px] relative group flex flex-col h-[340px] transition-all duration-300 hover:shadow-[8px_8px_0_#FF6D87] hover:-translate-y-1 hover:-translate-x-1 cursor-pointer block no-underline">
          <div class="absolute top-[24px] right-[24px] ed-label-caps text-[#cfc4c5] font-mono group-hover:text-black transition-colors">04</div>
          <div class="w-[48px] h-[48px] border border-black flex items-center justify-center mb-[40px] bg-white transition-colors duration-300 group-hover:bg-[#FF6D87] group-hover:border-[#FF6D87]">
            <span class="material-symbols-outlined text-black group-hover:text-white transition-colors">subtitles</span>
          </div>
          <h2 class="text-black tracking-tighter uppercase font-black text-[24px] mb-[16px] leading-none">CAPTION MAKER</h2>
          <p class="ed-label-caps text-[10px] tracking-widest text-[#4c4546] mb-auto leading-relaxed">WRITE CATCHY, ENGAGING CAPTIONS FOR YOUR INSTAGRAM PHOTOS AND VIDEOS.</p>
          <div class="mt-auto pt-[24px] flex items-center gap-[8px] text-black font-bold tracking-widest text-[12px] group-hover:text-[#FF6D87] transition-colors">
            <span>START CAPTIONING</span>
            <span class="material-symbols-outlined text-[16px] group-hover:translate-x-1 transition-transform">arrow_forward</span>
          </div>
        </a>

        {/* 05: PROMPT TO IMAGE */}
        <a href="/tools/prompt-to-image" class="bg-white p-[40px] relative group flex flex-col h-[340px] transition-all duration-300 hover:shadow-[8px_8px_0_#FF6D87] hover:-translate-y-1 hover:-translate-x-1 cursor-pointer block no-underline">
          <div class="absolute top-[24px] right-[24px] ed-label-caps text-[#cfc4c5] font-mono group-hover:text-black transition-colors">05</div>
          <div class="w-[48px] h-[48px] border border-black flex items-center justify-center mb-[40px] bg-white transition-colors duration-300 group-hover:bg-[#FF6D87] group-hover:border-[#FF6D87]">
            <span class="material-symbols-outlined text-black group-hover:text-white transition-colors">brush</span>
          </div>
          <h2 class="text-black tracking-tighter uppercase font-black text-[24px] mb-[16px] leading-none">PROMPT TO IMAGE</h2>
          <p class="ed-label-caps text-[10px] tracking-widest text-[#4c4546] mb-auto leading-relaxed">TEST YOUR PROMPTS AND GENERATE IMAGES DIRECTLY WITHIN THE APP.</p>
          <div class="mt-auto pt-[24px] flex items-center gap-[8px] text-black font-bold tracking-widest text-[12px] group-hover:text-[#FF6D87] transition-colors">
            <span>START GENERATING</span>
            <span class="material-symbols-outlined text-[16px] group-hover:translate-x-1 transition-transform">arrow_forward</span>
          </div>
        </a>

        {/* 06: CHROME EXTENSION */}
        <a href="/extension" class="bg-white p-[40px] relative group flex flex-col h-[340px] transition-all duration-300 hover:shadow-[8px_8px_0_#FF6D87] hover:-translate-y-1 hover:-translate-x-1 cursor-pointer block no-underline">
          <div class="absolute top-[24px] right-[24px] ed-label-caps text-[#cfc4c5] font-mono group-hover:text-black transition-colors">06</div>
          <div class="w-[48px] h-[48px] border border-black flex items-center justify-center mb-[40px] bg-white transition-colors duration-300 group-hover:bg-[#FF6D87] group-hover:border-[#FF6D87]">
            <span class="material-symbols-outlined text-black group-hover:text-white transition-colors">extension</span>
          </div>
          <h2 class="text-black tracking-tighter uppercase font-black text-[24px] mb-[16px] leading-none">CHROME EXTENSION</h2>
          <p class="ed-label-caps text-[10px] tracking-widest text-[#4c4546] mb-auto leading-relaxed">BRING YOUR FAVORITE PROMPTS DIRECTLY INTO CHATGPT, CLAUDE, AND GEMINI.</p>
          <div class="mt-auto pt-[24px] flex items-center gap-[8px] text-black font-bold tracking-widest text-[12px] group-hover:text-[#FF6D87] transition-colors">
            <span>GET THE EXTENSION</span>
            <span class="material-symbols-outlined text-[16px] group-hover:translate-x-1 transition-transform">arrow_forward</span>
          </div>
        </a>

        {/* 07: ARCHIVE */}
        <a href="/dashboard" class="bg-black p-[40px] relative group flex flex-col h-[340px] transition-all duration-300 hover:shadow-[8px_8px_0_#FF6D87] hover:-translate-y-1 hover:-translate-x-1 cursor-pointer block no-underline">
          <div class="absolute top-[24px] right-[24px] ed-label-caps text-white font-mono opacity-30">07</div>
          <div class="w-[48px] h-[48px] border border-white flex items-center justify-center mb-[40px] bg-black transition-colors duration-300 group-hover:bg-[#FF6D87] group-hover:border-[#FF6D87]">
            <span class="material-symbols-outlined text-white group-hover:text-white transition-colors">history</span>
          </div>
          <h2 class="text-white tracking-tighter uppercase font-black text-[24px] mb-[16px] leading-none">MY ARCHIVE</h2>
          <p class="ed-label-caps text-[10px] tracking-widest text-[#cfc4c5] mb-auto leading-relaxed">BROWSE YOUR PERSONAL COLLECTION OF SAVED PROMPTS AND GENERATED IMAGES.</p>
          <div class="mt-auto pt-[24px] flex items-center gap-[8px] text-white font-bold tracking-widest text-[12px] group-hover:text-[#FF6D87] transition-colors">
            <span>OPEN ARCHIVE</span>
            <span class="material-symbols-outlined text-[16px] group-hover:translate-x-1 transition-transform">arrow_forward</span>
          </div>
        </a>

      </div>

      {/* Explore Library CTA */}
      <div class="mt-[80px] border-[4px] border-black bg-white p-[40px] sm:p-[60px] flex flex-col items-center justify-center text-center shadow-[12px_12px_0_#FF6D87] transition-all duration-300 hover:-translate-y-1 hover:-translate-x-1 hover:shadow-[16px_16px_0_#FF6D87]">
        <h2 class="text-black tracking-tighter uppercase font-black text-[32px] sm:text-[48px] mb-[16px] leading-none">
          Need Inspiration<span class="text-[#FF6D87]">?</span>
        </h2>
        <p class="ed-body-main text-[#4c4546] max-w-[600px] mb-[32px]">
          See what other creators are making in our community library. Find the perfect prompt to start your next masterpiece.
        </p>
        <a href="/#library" class="bg-black text-white px-[32px] py-[16px] font-bold tracking-widest text-[14px] uppercase hover:bg-[#FF6D87] transition-colors duration-300 inline-flex items-center gap-[8px] no-underline">
          <span>Explore Library</span>
          <span class="material-symbols-outlined">arrow_forward</span>
        </a>
      </div>

    </div>
  </div>
</Layout>
