---
import Layout from '../components/layout/Layout.astro';

const title = "Terms of Use | Love4Prompts";
const description = "Terms of Use for Love4Prompts. Learn about prompt ownership, API usage rules, and acceptable use guidelines.";
---

<Layout title={title} description={description}>
  <div class="max-w-3xl mx-auto px-6 py-16 text-white relative z-10">
    <div class="mb-12">
      <h1 class="text-4xl font-light tracking-tight mb-2 text-white">Terms of Use</h1>
      <p class="text-white/40 text-sm font-mono">Last updated: June 2026</p>
    </div>

    <div class="space-y-10">
      <section class="space-y-3">
        <h2 class="text-2xl font-bold tracking-tight text-white/90">1. Acceptance</h2>
        <p class="text-[var(--color-text-secondary)] leading-relaxed text-sm">
          By accessing or using love4prompts, you agree to comply with and be bound by these Terms of Use. If you do not agree to these terms, please do not use the tool.
        </p>
      </section>

      <section class="space-y-3">
        <h2 class="text-2xl font-bold tracking-tight text-white/90">2. What love4prompts Is</h2>
        <p class="text-[var(--color-text-secondary)] leading-relaxed text-sm">
          love4prompts is a free AI prompt enhancement toolkit. We provide AI-generated suggestions to help structure your prompts for third-party AI models. Because AI output is dynamic, results are provided "as is" and are not guaranteed to be accurate, complete, or suitable for any specific context.
        </p>
      </section>

      <section class="space-y-3">
        <h2 class="text-2xl font-bold tracking-tight text-white/90">3. Acceptable Use</h2>
        <p class="text-[var(--color-text-secondary)] leading-relaxed text-sm">
          You agree to use this tool responsibly. You explicitly agree not to:
        </p>
        <ul class="list-disc pl-5 text-[var(--color-text-secondary)] leading-relaxed text-sm space-y-2">
          <li>Use the tool to generate prompts designed to create harmful, illegal, abusive, or malicious content.</li>
          <li>Attempt to reverse engineer, scrape, or systematically exploit the backend API.</li>
          <li>Use automated scripts or bots to mass-generate prompts through the service.</li>
          <li>Misrepresent AI-generated content as human-written in contexts where that distinction is required.</li>
        </ul>
      </section>

      <section class="space-y-3">
        <h2 class="text-2xl font-bold tracking-tight text-white/90">4. Intellectual Property</h2>
        <ul class="list-disc pl-5 text-[var(--color-text-secondary)] leading-relaxed text-sm space-y-2">
          <li><strong>Your Input:</strong> The raw prompts you type remain yours. We do not claim ownership over any text you enter.</li>
          <li><strong>AI Output:</strong> The enhanced output generated by our tool is yours to use, copy, and modify freely.</li>
          <li><strong>Platform Rights:</strong> The love4prompts name, logo, site architecture, and product designs are owned by eMitra Technologies and are protected by intellectual property laws.</li>
        </ul>
      </section>

      <section class="space-y-3">
        <h2 class="text-2xl font-bold tracking-tight text-white/90">5. Disclaimer</h2>
        <p class="text-[var(--color-text-secondary)] leading-relaxed text-sm">
          This service is provided "as is" and "as available" without warranties of any kind. We do not guarantee uninterrupted or error-free service and are not liable for any direct, indirect, or consequential damages arising from your use of the toolkit.
        </p>
      </section>

      <section class="space-y-3">
        <h2 class="text-2xl font-bold tracking-tight text-white/90">6. Changes</h2>
        <p class="text-[var(--color-text-secondary)] leading-relaxed text-sm">
          We may update these terms from time to time. Continued use of love4prompts after any changes are posted constitutes your acceptance of the updated terms.
        </p>
      </section>

      <section class="space-y-3">
        <h2 class="text-2xl font-bold tracking-tight text-white/90">7. Contact</h2>
        <p class="text-[var(--color-text-secondary)] leading-relaxed text-sm">
          If you have any questions or feedback regarding these terms, reach out to us at <a href="mailto:nishchaydev@outlook.com" class="text-[var(--color-primary)] hover:underline">nishchaydev@outlook.com</a>.
        </p>
      </section>
    </div>
  </div>
</Layout>
