---
import Layout from '../components/layout/Layout.astro';
import { supabase } from '../lib/supabase';
import { PinterestGallery } from '../components/library/PinterestGallery';
import { AdSlot } from '../components/ads/AdSlot';
import { mockPrompts } from '../lib/mock-data';

const { data: dbPrompts, error } = await supabase
  .from('prompts')
  .select('*')
  .eq('is_public', true)
  .order('created_at', { ascending: false });

if (error) {
  console.error('[Library] Supabase fetch error. Using fallback mock data:', error);
}

const isUsingFallback = !!error || !dbPrompts || dbPrompts.length === 0;
const prompts = isUsingFallback ? mockPrompts : dbPrompts;
---

<Layout title="Community Library | Love4Prompts" 
  description="Discover, copy, and use battle-tested AI prompts shared by top creators in the Love4Prompts community.">
  
  <div class="flex flex-1 relative min-h-screen overflow-x-hidden">
    <main class="w-full relative z-10">
      <div class="px-5 sm:px-8 max-w-[1400px] mx-auto pt-12 sm:pt-20 pb-8">
        <div class="flex flex-col mb-10">
          <div class="badge-pill badge-pill--active w-fit mb-6">
            Community Archive
          </div>
          <h1 class="font-[Anton] uppercase text-[var(--color-text)] text-[40px] sm:text-[56px] lg:text-[68px] leading-[0.95] mb-4">
            The <span class="gradient-text">Library</span>
          </h1>
          <p class="text-[var(--color-text-secondary)] font-[Epilogue] text-[16px] sm:text-[18px] leading-relaxed max-w-2xl">
            <strong class="text-[var(--color-text)]">By the creator, for the creator.</strong> Access thousands of curated, battle-tested AI prompts shared by top creators. Copy, modify, and elevate your AI creations.
          </p>
        </div>
      </div>

      <div class="mx-auto mt-2 mb-8 hidden md:flex justify-center w-full max-w-[1400px] px-5">
        <AdSlot type="leaderboard" />
      </div>

      <div class="pb-12 px-5 sm:px-8 max-w-[1400px] mx-auto">
        <PinterestGallery client:visible initialPrompts={prompts} />
      </div>
    </main>
  </div>
</Layout>
