---
import Layout from "../components/layout/Layout.astro";
import { supabase } from "../lib/supabase";
import { AdSlot } from "../components/ads/AdSlot";
import { mockPrompts } from "../lib/mock-data";
import { PinterestGallery } from "../components/library/PinterestGallery";

const { data: dbPrompts, error } = await supabase
  .from("prompts")
  .select("*")
  .eq("is_public", true)
  .order("created_at", { ascending: false });

if (error) console.error("Error fetching prompts:", error);

const prompts = dbPrompts && dbPrompts.length > 0 ? dbPrompts : mockPrompts;

const title = "Love4Prompts — Recreate Viral AI Image Trends in Seconds";
const description =
  "Discover trending AI image styles from across the internet. Copy the prompt or launch directly into ChatGPT, Gemini or Claude and recreate the trend with your own face.";

/* Category definitions for the grid (Exactly 10 categories) */
const categories = [
  { name: "Boys", color: "#1482A3", count: prompts.filter((p: any) => p.category === "Boys").length },
  { name: "Girls", color: "#FF6D87", count: prompts.filter((p: any) => p.category === "Girls").length },
  { name: "Professional", color: "#06D6A0", count: prompts.filter((p: any) => p.category === "Professional").length },
  { name: "AI art", color: "#9b59b6", count: prompts.filter((p: any) => p.category === "AI art").length },
  { name: "Birthday", color: "#FFD166", count: prompts.filter((p: any) => p.category === "Birthday").length },
  { name: "Festivals", color: "#e67e22", count: prompts.filter((p: any) => p.category === "Festivals").length },
  { name: "Posters", color: "#1abc9c", count: prompts.filter((p: any) => p.category === "Posters").length },
  { name: "Netflix typo", color: "#e74c3c", count: prompts.filter((p: any) => p.category === "Netflix typo").length },
  { name: "Memories", color: "#34495e", count: prompts.filter((p: any) => p.category === "Memories").length },
  { name: "Anniversary", color: "#FF3B30", count: prompts.filter((p: any) => p.category === "Anniversary").length },
];

/* Get trending prompts (sorted by views) for the floating hero cards */
const trendingPrompts = [...prompts].sort((a: any, b: any) => (b.view_count || 0) - (a.view_count || 0)).slice(0, 4);

/* How it works steps - EMOJIS REMOVED */
const steps = [
  { num: "01", title: "Discover", desc: "Browse viral AI image trends from TikTok, Instagram & Pinterest" },
  { num: "02", title: "Open", desc: "Tap any trend to see the AI prompt behind the viral image" },
  { num: "03", title: "Copy or Launch", desc: "Copy the prompt or launch directly into ChatGPT, Gemini or Claude" },
  { num: "04", title: "Add Your Photo", desc: "Upload your own photo as the reference image" },
  { num: "05", title: "Become the Trend", desc: "Get your personalized version of the viral AI image" },
];
---

<Layout title={title} description={description} theme="editorial">
  <div class="flex flex-1 relative min-h-screen">
    {/* Main Canvas */}
    <main
      class="relative z-10 flex-1 pt-[40px] lg:pt-[60px] xl:pt-[80px] px-[20px] sm:px-[40px] max-w-7xl mx-auto pb-[60px] w-full"
    >
      {/* ═══ HERO: Trend Discovery ═══ */}
      <section
        class="relative w-full pb-[60px] lg:pb-[80px] flex flex-col items-center text-center"
      >
        {/* Decorative Grid Background */}
        <div
          class="absolute inset-0 z-0 pointer-events-none"
          style="background-image: radial-gradient(#000 1px, transparent 1px); background-size: 32px 32px; opacity: 0.1;"
        >
        </div>

        {/* Floating Trend Cards — Left */}
        <div
          class="hidden lg:block absolute lg:left-0 xl:left-4 top-[10%] lg:w-[140px] xl:w-[200px] -rotate-6 z-0 md:hover:rotate-0 transition-transform duration-300"
        >
          <div
            class="bg-white border-[3px] border-black p-2 shadow-[4px_4px_0_#000] lg:shadow-[6px_6px_0_#000] rounded-[12px]"
          >
            {trendingPrompts[0]?.image_url && (
              <img
                src={trendingPrompts[0].image_url}
                fetchpriority="high"
                loading="eager"
                width="400"
                height="300"
                class="w-full h-[100px] lg:h-[120px] xl:h-[150px] object-cover rounded-[6px] border-[2px] border-black"
                alt={trendingPrompts[0].title}
              />
            )}
            <p
              class="font-black text-[8px] lg:text-[10px] uppercase mt-2 text-center tracking-widest text-black"
            >
              {trendingPrompts[0]?.title || "Trending"}
            </p>
          </div>
        </div>

        {/* Floating Trend Cards — Right */}
        <div
          class="hidden lg:block absolute lg:right-0 xl:right-4 top-[5%] lg:w-[130px] xl:w-[180px] rotate-3 z-0 md:hover:rotate-0 transition-transform duration-300"
        >
          <div
            class="bg-[#FFD166] border-[3px] border-black p-2 shadow-[4px_4px_0_#000] lg:shadow-[6px_6px_0_#000] rounded-[12px]"
          >
            {trendingPrompts[1]?.image_url && (
              <img
                src={trendingPrompts[1].image_url}
                fetchpriority="high"
                loading="eager"
                width="400"
                height="300"
                class="w-full h-[80px] lg:h-[100px] xl:h-[120px] object-cover rounded-[6px] border-[2px] border-black"
                alt={trendingPrompts[1].title}
              />
            )}
            <p
              class="font-black text-[8px] lg:text-[10px] uppercase mt-2 text-center tracking-widest text-black"
            >
              {trendingPrompts[1]?.title || "Trending"}
            </p>
          </div>
        </div>

        <div
          class="relative z-10 max-w-4xl mx-auto px-4 flex flex-col items-center"
        >
          {/* Pill Badge */}
          <div
            class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-white border-[2px] border-black shadow-[4px_4px_0_#000] mb-6 transition-all hover:-translate-y-0.5 hover:shadow-[6px_6px_0_#000] active:scale-95 duration-200"
          >
            <span
              class="w-3 h-3 rounded-full bg-[#FF6D87] border-[2px] border-black animate-pulse"
            ></span>
            <span
              class="text-[12px] font-black tracking-widest text-black uppercase"
              >SEE THE TREND. BE THE TREND.</span
            >
          </div>

          <h1
            class="text-black uppercase font-black text-[32px] sm:text-[40px] md:text-[56px] lg:text-[56px] xl:text-[72px] leading-[0.95] mb-6 max-w-[850px] lg:max-w-[700px] xl:max-w-[850px] relative z-10"
          >
            RECREATE VIRAL AI IMAGE <br class="hidden sm:block" />
            <span
              class="text-[#1482A3] drop-shadow-[2px_2px_0_#000] md:drop-shadow-[4px_4px_0_#000] tracking-tighter"
              >TRENDS IN SECONDS.</span
            >
          </h1>

          <p
            class="text-black font-semibold text-[18px] sm:text-[22px] leading-relaxed max-w-2xl mx-auto mb-8 whitespace-pre-line"
          >
            Browse trending image styles.
            Click on Create Me
            Put yourself into the trend.
          </p>

          <div
            class="flex flex-col sm:flex-row justify-center gap-4 w-full sm:w-auto relative z-20"
          >
            <a
              href="#trends-feed"
              class="magnetic-btn bg-[#FF6D87] text-white px-8 py-4 rounded-full font-black text-[16px] uppercase tracking-wide border-[3px] border-black shadow-[4px_4px_0_#000] hover:-translate-y-1 hover:scale-105 active:scale-95 hover:shadow-[6px_6px_0_#000] transition-all duration-200"
            >
              Explore Trends
            </a>
            <a
              href="#how-it-works"
              class="magnetic-btn bg-white text-black px-8 py-4 rounded-full font-black text-[16px] uppercase tracking-wide border-[3px] border-black shadow-[4px_4px_0_#000] hover:-translate-y-1 hover:scale-105 active:scale-95 hover:shadow-[6px_6px_0_#FF6D87] transition-all duration-200"
            >
              How It Works
            </a>
          </div>
        </div>
      </section>

      {/* Hero Leaderboard Ad */}
      <div class="mx-auto mt-4 mb-12 hidden md:flex justify-center w-full">
        <AdSlot type="leaderboard" />
      </div>
      <div class="mx-auto mt-4 mb-12 flex md:hidden justify-center w-full">
        <AdSlot type="banner" />
      </div>

      {/* ═══ LIVE TRENDS FEED ═══ */}
      <section id="trends-feed" class="py-[60px] px-4 md:px-[40px] border-t-4 border-black">
        <div class="flex justify-between items-end mb-[32px] border-b-[4px] border-black pb-[16px]">
          <h2
            class="text-black tracking-tighter uppercase font-black text-[32px] sm:text-[48px] leading-none"
          >
            Live Trends Feed
          </h2>
          <span class="text-[12px] font-black uppercase text-gray-500 flex items-center gap-1.5">
            <span class="w-2.5 h-2.5 rounded-full bg-red-500 animate-ping"></span> Live Updates
          </span>
        </div>
        <PinterestGallery client:visible initialPrompts={prompts} />
      </section>

      {/* ═══ HOW IT WORKS ═══ */}
      <section id="how-it-works" class="py-[60px] px-4 md:px-[40px] border-t-4 border-black">
        <h2
          class="text-black tracking-tighter uppercase font-black text-[32px] sm:text-[48px] mb-[16px] text-center"
        >
          How It Works
        </h2>
        <p class="text-center text-gray-600 font-bold tracking-widest text-[14px] uppercase mb-[48px]">
          From scroll to stunning in 5 steps
        </p>
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-5 gap-6">
          {steps.map((step) => (
            <div class="relative bg-white border-[3px] border-black rounded-[20px] p-6 shadow-[4px_4px_0_#000] hover:-translate-y-1.5 hover:scale-[1.01] hover:shadow-[6px_6px_0_#FF6D87] active:scale-[0.99] transition-all duration-300 text-center">
              <div class="inline-block bg-black text-white text-[10px] font-black px-3 py-1 rounded-full mb-3 uppercase tracking-widest">
                Step {step.num}
              </div>
              <h3 class="font-black text-[18px] text-black uppercase tracking-tight mb-2">{step.title}</h3>
              <p class="text-gray-600 text-[13px] leading-snug">{step.desc}</p>
            </div>
          ))}
        </div>
      </section>

      {/* ═══ CATEGORIES ═══ */}
      <section class="py-[60px] px-4 md:px-[40px] border-t-4 border-black">
        <h2
          class="text-black tracking-tighter uppercase font-black text-[32px] sm:text-[48px] mb-[40px] border-b-[4px] border-black pb-[16px]"
        >
          Browse by Category
        </h2>
        <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-5 gap-4 md:gap-6">
          {categories.map((cat) => (
            <a href={`/library?category=${cat.name}`} class="group block">
              <div
                class="relative border-[3px] border-black rounded-[16px] p-6 shadow-[4px_4px_0_#000] hover:-translate-y-1.5 hover:scale-[1.02] hover:shadow-[6px_6px_0_#FF6D87] active:scale-[0.98] transition-all duration-200 text-center overflow-hidden bg-white"
              >
                <div class="text-xs font-black uppercase tracking-widest text-gray-400 mb-2">Topic</div>
                <h3 class="font-black text-[15px] sm:text-[18px] text-black uppercase tracking-tight mb-2 group-hover:text-[#FF6D87] transition-colors">{cat.name}</h3>
                <p class="text-gray-500 text-[11px] font-bold uppercase tracking-widest">
                  {cat.count} {cat.count === 1 ? "trend" : "trends"}
                </p>
                <div
                  class="absolute inset-0 opacity-0 group-hover:opacity-100 transition-opacity duration-300 pointer-events-none"
                  style={`background: linear-gradient(135deg, ${cat.color}20, transparent);`}
                ></div>
              </div>
            </a>
          ))}
        </div>
      </section>

      {/* ═══ TOOLS & EXTENSION ECOSYSTEM (At the very bottom!) ═══ */}
      <section class="py-[60px] px-4 md:px-[40px] border-t-4 border-black">
        <h2
          class="text-black tracking-tighter uppercase font-black text-[32px] sm:text-[48px] mb-[16px] text-center"
        >
          Tools & Plug & Play Extension
        </h2>
        <p class="text-center text-gray-600 font-bold tracking-widest text-[14px] uppercase mb-[48px]">
          Power up your creation flow inside any model or site
        </p>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-8 max-w-6xl mx-auto">
          {/* Left Card: AI Prompt Tools */}
          <div class="bg-white border-[4px] border-black rounded-[24px] p-6 sm:p-8 shadow-[8px_8px_0_#1482A3] hover:-translate-y-1 hover:scale-[1.005] hover:shadow-[12px_12px_0_#1482A3] active:scale-[0.995] transition-all duration-300 flex flex-col justify-between">
            <div>
              <div class="inline-block bg-[#1482A3] text-white text-[10px] font-black px-3 py-1 rounded-full mb-4 uppercase tracking-widest border-[2px] border-black shadow-[2px_2px_0_#000]">
                Creator Tools
              </div>
              <h3 class="font-black text-2xl uppercase tracking-tight text-black mb-3">Interactive AI Tools</h3>
              <p class="text-gray-600 text-sm leading-relaxed mb-6">
                Optimize, generate, and extract prompts with ease. Our dedicated tools take care of the technical complexity behind the scenes.
              </p>
              <div class="space-y-4">
                <a href="/tools/prompt-maker" class="flex items-center justify-between p-3 border-2 border-black rounded-xl hover:bg-[#1482A3]/10 hover:scale-[1.01] active:scale-[0.99] transition-all group">
                  <div class="flex items-center gap-3">
                    <span class="text-xl">✨</span>
                    <div>
                      <h4 class="font-black text-xs uppercase tracking-tight text-black">Prompt Maker</h4>
                      <p class="text-[11px] text-gray-500">Visual style builder & model targeter</p>
                    </div>
                  </div>
                  <span class="text-black font-black group-hover:translate-x-1 transition-transform">→</span>
                </a>
                <a href="/tools/prompt-enhancer" class="flex items-center justify-between p-3 border-2 border-black rounded-xl hover:bg-[#1482A3]/10 hover:scale-[1.01] active:scale-[0.99] transition-all group">
                  <div class="flex items-center gap-3">
                    <span class="text-xl">🪄</span>
                    <div>
                      <h4 class="font-black text-xs uppercase tracking-tight text-black">Prompt Enhancer</h4>
                      <p class="text-[11px] text-gray-500">Auto-polish prompts for all models</p>
                    </div>
                  </div>
                  <span class="text-black font-black group-hover:translate-x-1 transition-transform">→</span>
                </a>
                <a href="/tools/image-to-prompt" class="flex items-center justify-between p-3 border-2 border-black rounded-xl hover:bg-[#1482A3]/10 hover:scale-[1.01] active:scale-[0.99] transition-all group">
                  <div class="flex items-center gap-3">
                    <span class="text-xl">📸</span>
                    <div>
                      <h4 class="font-black text-xs uppercase tracking-tight text-black">Image to Prompt</h4>
                      <p class="text-[11px] text-gray-500">Extract text prompts from any reference image</p>
                    </div>
                  </div>
                  <span class="text-black font-black group-hover:translate-x-1 transition-transform">→</span>
                </a>
              </div>
            </div>
            <a href="/tools" class="mt-8 inline-block text-center bg-black text-white hover:bg-[#1482A3] border-[3px] border-black py-3 rounded-full font-black uppercase text-sm tracking-wide shadow-[4px_4px_0_#000] hover:shadow-none hover:-translate-y-0.5 active:scale-95 transition-all">
              Launch Toolkit →
            </a>
          </div>

          {/* Right Card: Chrome Extension */}
          <div class="bg-[#FAEFED] border-[4px] border-black rounded-[24px] p-6 sm:p-8 shadow-[8px_8px_0_#FF6D87] hover:-translate-y-1 hover:scale-[1.005] hover:shadow-[12px_12px_0_#FF6D87] active:scale-[0.995] transition-all duration-300 flex flex-col justify-between">
            <div>
              <div class="inline-block bg-[#FF6D87] text-white text-[10px] font-black px-3 py-1 rounded-full mb-4 uppercase tracking-widest border-[2px] border-black shadow-[2px_2px_0_#000]">
                Chrome Extension
              </div>
              <h3 class="font-black text-2xl uppercase tracking-tight text-black mb-3">Plug & Play Overlay</h3>
              <p class="text-gray-600 text-sm leading-relaxed mb-6">
                Take Love4Prompts with you. Open our overlay extension inside ChatGPT, Gemini, Claude, or Midjourney and inject trending styles directly into your chats with one click.
              </p>
              <div class="border-2 border-black bg-white rounded-xl p-4 shadow-[4px_4px_0_#000] relative overflow-hidden">
                <div class="flex items-center gap-3 mb-2">
                  <span class="w-3 h-3 bg-[#06D6A0] rounded-full border border-black shadow-[1px_1px_0_#000]"></span>
                  <span class="font-black text-xs uppercase tracking-wider text-black">Active in browser</span>
                </div>
                <p class="text-xs text-gray-700 leading-snug">
                  "No more tab-switching or manual copy-pasting. Seamlessly launch prompts and overlay trends directly inside the model's native UI."
                </p>
              </div>
            </div>
            <a href="/extension" class="mt-8 inline-block text-center bg-[#FF6D87] text-white hover:bg-black border-[3px] border-black py-3 rounded-full font-black uppercase text-sm tracking-wide shadow-[4px_4px_0_#000] hover:shadow-none hover:-translate-y-0.5 active:scale-95 transition-all">
              Install Extension →
            </a>
          </div>
        </div>
      </section>
    </main>
  </div>
</Layout>
