---
import Layout from '../components/layout/Layout.astro';
import { supabase } from '../lib/supabase';
import { PinterestGallery } from '../components/library/PinterestGallery';
import type { Prompt } from '../components/library/PromptCard';
import { mockPrompts } from '../lib/mock-data';

const { data: dbPrompts, error } = await supabase
  .from('prompts')
  .select('*')
  .eq('is_public', true)
  .order('created_at', { ascending: false });

if (error) console.error('Error fetching prompts:', error);

const prompts = (dbPrompts && dbPrompts.length > 0) ? dbPrompts : mockPrompts;

const title = "Love4Prompts — Making your everyday simple!";
const description = "Discover ready-to-use tools and prompts that save you time. No complex tech stuff. Just click, type, and get amazing results instantly.";

/* Tile accent colors cycle */
const accentColors = ['vermillion', 'cobalt', 'primary', 'secondary'] as const;
const accentHex: Record<string, string> = {
  vermillion: '#FF3B30',
  cobalt: '#0047BB',
  primary: '#000000',
  secondary: '#FF6D87',
};
/* Aspect ratios to match reference variety */
const aspects = ['aspect-[3/4]', 'aspect-square', 'aspect-video', 'aspect-[4/5]'];
---

<Layout title={title} description={description} theme="editorial">

  {/* ═══ MAIN CONTENT ═══ */}
  <div class="flex flex-1 relative bg-[#FAEFED] min-h-screen">
    {/* Grid Background */}
    <div 
      class="absolute inset-0 z-0 pointer-events-none opacity-[0.4]" 
      style={{
        backgroundImage: `
          linear-gradient(to right, #cfc4c5 1px, transparent 1px),
          linear-gradient(to bottom, #cfc4c5 1px, transparent 1px)
        `,
        backgroundSize: '40px 40px',
        backgroundPosition: 'center top'
      }}
    ></div>
    
    {/* Main Canvas */}
    <main class="relative z-10 flex-1 pt-[120px] px-[20px] sm:px-[40px] max-w-7xl mx-auto pb-[100px] w-full">

      {/* Hero Section */}
      <div class="flex flex-col lg:flex-row items-center gap-12 mb-[120px] mt-0 w-full">
        {/* Left Content */}
        <header class="flex-1 max-w-2xl z-10">
          <h1 class="text-black tracking-tighter uppercase font-black text-[48px] sm:text-[72px] md:text-[80px] mb-[24px] leading-[0.9]">
            Making <span class="text-[#FF6D87]">your</span> everyday <span class="text-[#FF6D87]">simple!</span>
          </h1>
          <p class="text-[#4c4546] font-medium text-[20px] sm:text-[24px] mb-[40px] leading-tight">
            {"Discover ready-to-use tools and prompts that save you time. No complex tech stuff. Just click, type, and get amazing results instantly.".split(' ').map((word, wordIndex, arr) => (
              <>
                <span class="inline-block whitespace-nowrap">
                  {word.split('').map((char) => (
                    <span class="inline-block transition-all duration-300 ease-out hover:-translate-y-1 hover:text-[#FF6D87]">
                      {char}
                    </span>
                  ))}
                </span>
                {wordIndex !== arr.length - 1 && ' '}
              </>
            ))}
          </p>
          <div class="flex flex-col sm:flex-row sm:flex-wrap gap-4">
            <a href="/tools" class="bg-[#FF6D87] text-white px-[30px] py-[15px] tracking-widest text-[14px] hover:bg-black transition-colors font-bold uppercase no-underline inline-block text-center shadow-[6px_6px_0_#000] rounded-full">
              EXPLORE TOOLS
            </a>
            <a href="#library" class="bg-transparent text-black border-2 border-black px-[30px] py-[15px] tracking-widest text-[14px] hover:bg-black hover:text-[#FAEFED] transition-colors font-bold uppercase no-underline inline-block text-center shadow-[6px_6px_0_#000] hover:shadow-[6px_6px_0_#FF6D87] rounded-full">
              BROWSE LIBRARY
            </a>
            <a href="/submit" class="bg-white text-black border-2 border-black px-[30px] py-[15px] tracking-widest text-[14px] hover:bg-black hover:text-white transition-colors font-bold uppercase no-underline inline-block text-center shadow-[6px_6px_0_#000] hover:shadow-[6px_6px_0_#FF6D87] rounded-full">
              SUBMIT PROMPT
            </a>
          </div>
        </header>

        {/* Right Content - Pinterest Style Floating Grid */}
        <div class="flex-1 relative w-full h-[500px] lg:h-[600px] hidden lg:block">
          {prompts.filter(p => p.image_url).slice(0, 5).map((prompt, i) => {
            // Pinterest-like floating positions
            const styles = [
              "top-[20px] left-[0%] w-[40%] h-[240px] z-10", // Top Left
              "top-[80px] left-[45%] w-[35%] h-[200px] z-20", // Top Right
              "top-[280px] left-[10%] w-[35%] h-[220px] z-20", // Bottom Left
              "top-[300px] left-[50%] w-[45%] h-[280px] z-30 scale-110", // Center focus
              "top-[180px] left-[85%] w-[25%] h-[180px] z-10", // Far Right
            ];
            
            return (
              <div class={`absolute ${styles[i]} transition-transform hover:scale-105 duration-300 hover:z-50 group`}>
                <img 
                  src={prompt.image_url} 
                  alt={prompt.title}
                  class="w-full h-full object-cover rounded-[32px] border-[3px] border-black shadow-[6px_6px_0_rgba(0,0,0,1)] group-hover:shadow-[8px_8px_0_#FF6D87] transition-all"
                />
              </div>
            );
          })}
        </div>
      </div>

      {/* Pinterest-Style Community Library */}
      <div id="library" class="pt-[80px] pb-[40px] px-4 md:px-[40px]">
        <h2 class="text-black tracking-tighter uppercase font-black text-[32px] sm:text-[48px] mb-[40px] border-b-[4px] border-black pb-[16px]">
          Community Library
        </h2>
        <PinterestGallery client:load initialPrompts={prompts} />
      </div>

    </main>
  </div>

</Layout>
