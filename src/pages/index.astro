---
import Layout from '../components/layout/Layout.astro';
import { InteractiveLibrary } from '../components/library/InteractiveLibrary';
import { TestimonialSection } from '../components/marketing/TestimonialSection';
import { FeaturesGrid } from '../components/marketing/FeaturesGrid';
import { HowItWorks } from '../components/marketing/HowItWorks';
import { UniversalBar } from '../components/hero/UniversalBar';
import { AnimatedSection } from '../components/ui/AnimatedSection';
import { supabase } from '../lib/supabase';
import type { Prompt } from '../components/library/PromptCard';
import { mockPrompts } from '../lib/mock-data';
import { TrustedBy } from '../components/marketing/TrustedBy';
import { DeployShowcase } from '../components/marketing/DeployShowcase';

const { data: dbPrompts, error } = await supabase
  .from('prompts')
  .select('*')
  .eq('is_public', true)
  .order('created_at', { ascending: false });

if (error) console.error('Error fetching prompts:', error);

const prompts = (dbPrompts && dbPrompts.length > 0) ? dbPrompts : mockPrompts;
const styles = Array.from(new Set(prompts?.map(p => p.style).filter(Boolean) || [])) as string[];

const title = "Love4Prompts — The prompt toolkit for every AI";
const description = "One search bar. Six AI tools. Enhance, generate, translate, and discover prompts for ChatGPT, Midjourney, Claude, DALL-E, Gemini & Flux. Free, no signup.";
---

<Layout title={title} description={description}>
  <div>

    {/* ═══ HERO ═══════════════════════════════════════════════════ */}
    <section class="flex flex-col items-center justify-center px-4 pt-20 sm:pt-28 pb-12 sm:pb-20 z-10 relative">
      <div class="flex flex-col items-center text-center gap-4 sm:gap-5 w-full max-w-[720px] mx-auto">

        {/* Tagline — small, monospace, futuristic */}
        <p class="text-[11px] font-mono font-bold text-[var(--color-primary)] uppercase tracking-[0.2em] mb-2">
          Universal Prompt Toolkit
        </p>

        {/* H1 — thin, elegant, no gradient spam, tight tracking */}
        <h1 class="text-[clamp(36px,6vw,60px)] font-light tracking-[-0.045em] leading-[1.05] text-white">
          Write better prompts.<br />
          <span class="text-white/30 font-light">Ship better results.</span>
        </h1>

        {/* Sub — clear, human, no jargon */}
        <p class="text-[15.5px] text-white/45 max-w-[460px] leading-relaxed font-medium">
          One console bar that enhances, generates, and translates prompts across every major AI model. Just type.
        </p>

        {/* UniversalBar */}
        <div class="w-full mt-4">
          <UniversalBar client:load />
        </div>

        {/* Micro-stats — subtle, monospace */}
        <div class="flex flex-wrap items-center justify-center gap-x-5 gap-y-2 text-[10px] sm:text-[11px] font-bold text-white/35 mt-2 font-mono uppercase tracking-wider">
          <span class="tabular-nums">6 tools</span>
          <span class="w-px h-3 bg-white/[0.06] hidden sm:block"></span>
          <span>Free</span>
          <span class="w-px h-3 bg-white/[0.06] hidden sm:block"></span>
          <span>No signup</span>
          <span class="w-px h-3 bg-white/[0.06] hidden sm:block"></span>
          <span>Works with 6+ models</span>
        </div>
      </div>
    </section>

    {/* ═══ FEATURES ═════════════════════════════════════════════ */}
    <FeaturesGrid client:visible />

    {/* ═══ DEPLOY SHOWCASE ══════════════════════════════════════ */}
    <DeployShowcase client:visible />

    {/* ═══ HOW IT WORKS ═════════════════════════════════════════ */}
    <HowItWorks client:visible />

    {/* ═══ TESTIMONIALS ═════════════════════════════════════════ */}
    <TestimonialSection />

    {/* ═══ LIBRARY ══════════════════════════════════════════════ */}
    <section class="pb-24" id="library">
      <AnimatedSection client:visible className="container mx-auto px-4 pt-20 mb-6 border-t border-white/[0.03] text-center">
        <p class="text-[11px] font-mono font-bold text-[var(--color-primary)] uppercase tracking-[0.2em] mb-2">Explore</p>
        <h2 class="text-2xl md:text-[32px] font-light text-white tracking-[-0.04em]">Prompt Library</h2>
        <p class="text-white/30 mt-2 text-[13px] font-medium">
          Curated prompts across all categories. Copy any. Use instantly.
        </p>
      </AnimatedSection>
      <div class="container mx-auto px-4">
        <InteractiveLibrary client:load prompts={prompts as Prompt[]} styles={styles} />
      </div>
    </section>
  </div>
</Layout>
