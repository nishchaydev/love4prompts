---
import Layout from "../components/layout/Layout.astro";
import { supabase } from "../lib/supabase";
import { AdSlot } from "../components/ads/AdSlot";
import { mockPrompts } from "../lib/mock-data";
import { PinterestGallery } from "../components/library/PinterestGallery";

const { data: dbPrompts, error } = await supabase
  .from("prompts")
  .select("*")
  .eq("is_public", true)
  .order("created_at", { ascending: false });

if (error) console.error("Error fetching prompts:", error);

const prompts = dbPrompts && dbPrompts.length > 0 ? dbPrompts : mockPrompts;

const title = "Love4Prompts — Recreate Viral AI Image Trends in Seconds";
const description =
  "See the Trend. Be the Trend. Discover trending AI image styles from Instagram, TikTok & Pinterest. Copy the prompt or launch directly into ChatGPT, Gemini or Claude.";

const categories = [
  { name: "Boys", emoji: "🧑", count: prompts.filter((p: any) => p.category === "Boys").length },
  { name: "Girls", emoji: "👩", count: prompts.filter((p: any) => p.category === "Girls").length },
  { name: "Professional", emoji: "💼", count: prompts.filter((p: any) => p.category === "Professional").length },
  { name: "AI art", emoji: "🎨", count: prompts.filter((p: any) => p.category === "AI art").length },
  { name: "Birthday", emoji: "🎂", count: prompts.filter((p: any) => p.category === "Birthday").length },
  { name: "Festivals", emoji: "🎊", count: prompts.filter((p: any) => p.category === "Festivals").length },
  { name: "Posters", emoji: "📋", count: prompts.filter((p: any) => p.category === "Posters").length },
  { name: "Netflix typo", emoji: "🎬", count: prompts.filter((p: any) => p.category === "Netflix typo").length },
  { name: "Memories", emoji: "📸", count: prompts.filter((p: any) => p.category === "Memories").length },
  { name: "Anniversary", emoji: "💕", count: prompts.filter((p: any) => p.category === "Anniversary").length },
];

/* Top 6 trending images for hero showcase */
const heroImages = [...prompts]
  .filter((p: any) => p.image_url)
  .sort((a: any, b: any) => (b.view_count || 0) - (a.view_count || 0))
  .slice(0, 6);

const steps = [
  { num: "01", title: "Discover", desc: "Browse viral AI image trends from TikTok, Instagram & Pinterest", icon: "🔍" },
  { num: "02", title: "Open", desc: "Tap any trend to see the AI prompt behind the viral image", icon: "👆" },
  { num: "03", title: "Copy or Launch", desc: "Copy the prompt or launch directly into ChatGPT, Gemini or Claude", icon: "🚀" },
  { num: "04", title: "Add Your Photo", desc: "Upload your own photo as the reference image", icon: "🤳" },
  { num: "05", title: "Become the Trend", desc: "Get your personalized version of the viral AI image", icon: "⭐" },
];
---

<Layout title={title} description={description}>
  <div class="flex flex-1 relative min-h-screen">
    <main class="relative z-10 flex-1 w-full">

      {/* ═══════════════════════════════════════════════════
           HERO — Full-width, asymmetric, NOT a template
           ═══════════════════════════════════════════════════ */}
      <section class="relative w-full overflow-hidden" style="min-height: clamp(500px, 85vh, 800px);">

        {/* Background: scattered floating images (the product IS images) */}
        <div class="absolute inset-0 z-0 pointer-events-none" aria-hidden="true">
          {/* Subtle ambient gradient — static, zero GPU cost */}
          <div class="absolute top-0 left-0 w-full h-full bg-[radial-gradient(ellipse_80%_50%_at_20%_40%,rgba(225,29,72,0.04),transparent_70%)]"></div>
          <div class="absolute top-0 right-0 w-full h-full bg-[radial-gradient(ellipse_60%_60%_at_80%_60%,rgba(59,130,246,0.03),transparent_70%)]"></div>

          {/* Floating trend images — scattered organically */}
          {heroImages[0]?.image_url && (
            <div class="hidden lg:block absolute top-[8%] right-[8%] w-[180px] float-slow anim-scale-in delay-300" style="--float-rotate: -4deg;">
              <a href={`/prompt/${heroImages[0].slug}`} class="block rounded-2xl overflow-hidden border border-[var(--color-border)] shadow-[0_16px_48px_rgba(0,0,0,0.1)] hover:border-[var(--color-primary)]/40 transition-all duration-500 hover-tilt">
                <img src={heroImages[0].image_url} alt={heroImages[0].title} class="w-full h-[240px] object-cover" loading="eager" />
              </a>
              <p class="text-[10px] text-[var(--color-text-muted)] font-mono mt-2 text-center opacity-60">{heroImages[0].title}</p>
            </div>
          )}
          {heroImages[1]?.image_url && (
            <div class="hidden lg:block absolute top-[35%] right-[28%] w-[140px] float-medium anim-scale-in delay-500" style="--float-rotate: 5deg;">
              <a href={`/prompt/${heroImages[1].slug}`} class="block rounded-xl overflow-hidden border border-[var(--color-border)] shadow-[0_12px_36px_rgba(0,0,0,0.08)] hover:border-[var(--color-primary)]/40 transition-all duration-500 hover-tilt">
                <img src={heroImages[1].image_url} alt={heroImages[1].title} class="w-full h-[190px] object-cover" loading="eager" />
              </a>
            </div>
          )}
          {heroImages[2]?.image_url && (
            <div class="hidden xl:block absolute bottom-[15%] right-[6%] w-[160px] float-fast anim-scale-in delay-700" style="--float-rotate: -2deg;">
              <a href={`/prompt/${heroImages[2].slug}`} class="block rounded-2xl overflow-hidden border border-[var(--color-border)] shadow-[0_12px_40px_rgba(0,0,0,0.1)] hover:border-[var(--color-primary)]/40 transition-all duration-500 hover-tilt">
                <img src={heroImages[2].image_url} alt={heroImages[2].title} class="w-full h-[220px] object-cover" loading="lazy" decoding="async" />
              </a>
            </div>
          )}
          {heroImages[3]?.image_url && (
            <div class="hidden xl:block absolute top-[12%] right-[38%] w-[110px] float-slow anim-scale-in delay-800" style="--float-rotate: 7deg; animation-delay: 1s;">
              <a href={`/prompt/${heroImages[3].slug}`} class="block rounded-xl overflow-hidden border border-[var(--color-border)] shadow-[0_8px_24px_rgba(0,0,0,0.06)] hover:border-[var(--color-primary)]/40 transition-all duration-500 hover-tilt opacity-70">
                <img src={heroImages[3].image_url} alt={heroImages[3].title} class="w-full h-[150px] object-cover" loading="lazy" decoding="async" />
              </a>
            </div>
          )}
          {heroImages[4]?.image_url && (
            <div class="hidden 2xl:block absolute bottom-[30%] right-[42%] w-[100px] float-medium anim-scale-in delay-1000" style="--float-rotate: -6deg; animation-delay: 1.5s;">
              <a href={`/prompt/${heroImages[4].slug}`} class="block rounded-lg overflow-hidden border border-[var(--color-border)] shadow-[0_6px_20px_rgba(0,0,0,0.05)] hover:border-[var(--color-primary)]/40 transition-all duration-500 hover-tilt opacity-60">
                <img src={heroImages[4].image_url} alt={heroImages[4].title} class="w-full h-[130px] object-cover" loading="lazy" decoding="async" />
              </a>
            </div>
          )}
        </div>

        {/* Hero content — left-aligned, big and bold */}
        <div class="relative z-10 max-w-[1200px] mx-auto px-5 sm:px-8 pt-16 sm:pt-24 lg:pt-32 pb-20">

          {/* Badge — animated entrance */}
          <div class="anim-fade-up inline-flex items-center gap-2.5 px-4 py-2 rounded-full bg-[var(--color-bg-surface)] border border-[var(--color-border)] mb-8">
            <span class="w-2 h-2 rounded-full bg-[var(--color-success)] pulse-ring"></span>
            <span class="text-[12px] font-semibold tracking-wide text-[var(--color-text-secondary)] font-[Epilogue]">
              See the Trend. Be the Trend.
            </span>
          </div>

          {/* Headline — staggered word entrance */}
          <div class="max-w-[700px] mb-8" style="perspective: 600px;">
            <h1 class="text-[var(--color-text)] text-[44px] sm:text-[56px] lg:text-[72px] xl:text-[80px] leading-[0.95] font-[Anton] uppercase">
              <span class="hero-word" style="animation-delay: 0.1s;">Recreate</span>{" "}
              <span class="hero-word" style="animation-delay: 0.2s;">Viral</span>{" "}
              <span class="hero-word" style="animation-delay: 0.3s;">AI</span><br/>
              <span class="hero-word gradient-text" style="animation-delay: 0.45s; -webkit-text-fill-color: transparent;">Image</span>{" "}
              <span class="hero-word gradient-text" style="animation-delay: 0.55s; -webkit-text-fill-color: transparent;">Trends</span><br/>
              <span class="hero-word" style="animation-delay: 0.7s;">in</span>{" "}
              <span class="hero-word text-shimmer" style="animation-delay: 0.8s;">Seconds</span>
            </h1>
          </div>

          {/* Subhead — fade up with delay */}
          <p class="anim-fade-up delay-600 text-[var(--color-text-secondary)] font-[Epilogue] text-[16px] sm:text-[18px] leading-relaxed max-w-[520px] mb-10">
            Discover trending AI image styles from Instagram, TikTok & Pinterest.
            Pick a trend. Launch the prompt. <strong class="text-[var(--color-text)]">Put yourself in the picture.</strong>
          </p>

          {/* CTAs — slide in from left */}
          <div class="anim-slide-left delay-700 flex flex-col sm:flex-row gap-3">
            <a
              href="#trends-feed"
              class="magnetic-btn inline-flex items-center justify-center gap-2.5 px-8 py-4 rounded-full bg-[var(--color-primary)] hover:bg-[var(--color-primary-hover)] text-white font-bold text-[15px] shadow-[0_4px_24px_var(--color-primary-glow)] hover:shadow-[0_12px_40px_var(--color-primary-glow)] hover:scale-[1.03] active:scale-[0.97] transition-all duration-300 no-underline"
            >
              <svg class="w-5 h-5" viewBox="0 0 24 24" fill="currentColor"><path d="M13.5 0.67s0.74 2.65 0.74 4.8c0 2.06-1.35 3.73-3.41 3.73-2.07 0-3.63-1.67-3.63-3.73l.03-.36C5.21 7.51 4 10.62 4 14c0 4.42 3.58 8 8 8s8-3.58 8-8C20 8.61 17.41 3.8 13.5.67zM11.71 19c-1.78 0-3.22-1.4-3.22-3.14 0-1.62 1.05-2.76 2.81-3.12 1.77-.36 3.6-1.21 4.62-2.58.39 1.29.59 2.65.59 4.04 0 2.65-2.15 4.8-4.8 4.8z"/></svg>
              Explore Trends
            </a>
            <a
              href="#how-it-works"
              class="magnetic-btn inline-flex items-center justify-center gap-2 px-8 py-4 rounded-full bg-transparent border border-[var(--color-border-hover)] text-[var(--color-text-secondary)] hover:text-[var(--color-text)] hover:border-[var(--color-text-muted)] font-semibold text-[15px] hover:scale-[1.03] active:scale-[0.97] transition-all duration-300 no-underline"
            >
              How It Works
            </a>
          </div>

          {/* Social proof — inline, minimal */}
          <div class="anim-fade-up delay-1000 mt-14 flex flex-wrap items-center gap-6 text-[var(--color-text-muted)]">
            <div class="flex items-center gap-2">
              <span class="text-[18px] font-[Anton] text-[var(--color-text)]">{prompts.length}+</span>
              <span class="text-[11px] font-semibold uppercase tracking-wide font-[Epilogue]">trends</span>
            </div>
            <span class="text-[var(--color-border-hover)]">·</span>
            <div class="flex items-center gap-2">
              <span class="text-[18px] font-[Anton] text-[var(--color-text)]">10K+</span>
              <span class="text-[11px] font-semibold uppercase tracking-wide font-[Epilogue]">recreations</span>
            </div>
            <span class="text-[var(--color-border-hover)]">·</span>
            <div class="flex items-center gap-1.5">
              <span class="text-[11px] font-semibold uppercase tracking-wide font-[Epilogue]">Works with</span>
              <span class="text-[12px] font-bold text-[var(--color-text-secondary)] font-[Epilogue]">ChatGPT · Gemini · Claude</span>
            </div>
          </div>
        </div>

        {/* Mobile hero images (horizontal scroll strip) */}
        <div class="lg:hidden overflow-x-auto scrollbar-hide flex gap-3 px-5 pb-8 -mt-6">
          {heroImages.slice(0, 4).map((img: any) => (
            <a href={`/prompt/${img.slug}`} class="flex-shrink-0 w-[120px] rounded-xl overflow-hidden border border-[var(--color-border)] shadow-[0_4px_16px_rgba(0,0,0,0.06)] no-underline hover-tilt">
              <img src={img.image_url} alt={img.title} class="w-full h-[160px] object-cover" loading="lazy" decoding="async" />
            </a>
          ))}
        </div>
      </section>

      {/* Ad Slot */}
      <div class="mx-auto mb-8 hidden md:flex justify-center w-full max-w-[1200px] px-5">
        <AdSlot type="leaderboard" />
      </div>
      <div class="mx-auto mb-8 flex md:hidden justify-center w-full px-5">
        <AdSlot type="banner" />
      </div>

      {/* ═══ TRENDING NOW (the main feed) ═══ */}
      <section id="trends-feed" class="py-16 sm:py-20 px-5 sm:px-8 max-w-[1400px] mx-auto">
        <div class="flex justify-between items-end mb-10 reveal" id="trends-header">
          <div>
            <h2 class="text-[var(--color-text)] text-[32px] sm:text-[44px] font-[Anton] uppercase leading-none">
              Trending Now
            </h2>
            <p class="text-[var(--color-text-muted)] text-[14px] font-[Epilogue] mt-2">The hottest AI image trends right now</p>
          </div>
          <div class="hidden sm:flex items-center gap-2">
            <span class="w-2 h-2 rounded-full bg-[var(--color-success)] pulse-ring"></span>
            <span class="text-[11px] font-semibold text-[var(--color-text-muted)] uppercase tracking-wide font-[Epilogue]">Live</span>
          </div>
        </div>
        <PinterestGallery client:visible initialPrompts={prompts} />
      </section>

      {/* ═══ HOW IT WORKS ═══ */}
      <section id="how-it-works" class="py-16 sm:py-20 px-5 sm:px-8 max-w-[1200px] mx-auto">
        <div class="text-center mb-12 reveal" id="hiw-header">
          <h2 class="text-[var(--color-text)] text-[32px] sm:text-[44px] font-[Anton] uppercase leading-none mb-3">
            How It Works
          </h2>
          <p class="text-[var(--color-text-muted)] text-[14px] font-[Epilogue]">From scroll to stunning in 5 steps</p>
        </div>
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-5 gap-4 reveal-stagger" id="hiw-grid">
          {steps.map((step) => (
            <div class="glass-card p-5 text-center group cursor-default hover-tilt">
              <div class="text-[28px] mb-3 group-hover:scale-125 transition-transform duration-500">{step.icon}</div>
              <div class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full bg-[var(--color-primary-surface)] text-[var(--color-primary)] text-[10px] font-semibold uppercase tracking-wide font-[Epilogue] mb-3">
                Step {step.num}
              </div>
              <h3 class="font-[Anton] text-[18px] text-[var(--color-text)] uppercase mb-2">{step.title}</h3>
              <p class="text-[var(--color-text-muted)] text-[13px] leading-snug font-[Epilogue]">{step.desc}</p>
            </div>
          ))}
        </div>
      </section>

      {/* ═══ CATEGORIES ═══ */}
      <section class="py-16 sm:py-20 px-5 sm:px-8 max-w-[1200px] mx-auto">
        <h2 class="text-[var(--color-text)] text-[32px] sm:text-[44px] font-[Anton] uppercase leading-none mb-10 reveal" id="cat-header">
          Browse by Category
        </h2>
        <div class="flex gap-3 overflow-x-auto scrollbar-hide pb-4 -mx-5 px-5 sm:mx-0 sm:px-0 sm:flex-wrap reveal-stagger" id="cat-chips">
          {categories.map((cat) => (
            <a
              href={`/library?category=${cat.name}`}
              class="flex-shrink-0 inline-flex items-center gap-2 px-5 py-3 rounded-full bg-[var(--color-bg-surface)] border border-[var(--color-border)] hover:border-[var(--color-primary)]/40 hover:bg-[var(--color-primary-surface)] text-[var(--color-text-secondary)] hover:text-[var(--color-primary)] transition-all duration-200 no-underline group"
            >
              <span class="text-[16px] group-hover:scale-125 transition-transform duration-300">{cat.emoji}</span>
              <span class="text-[13px] font-semibold font-[Epilogue] whitespace-nowrap">{cat.name}</span>
              <span class="text-[11px] text-[var(--color-text-muted)] font-mono">{cat.count}</span>
            </a>
          ))}
        </div>
      </section>

      {/* ═══ TOOLS & EXTENSION ═══ */}
      <section class="py-16 sm:py-20 px-5 sm:px-8 max-w-[1200px] mx-auto">
        <div class="text-center mb-12 reveal" id="tools-header">
          <h2 class="text-[var(--color-text)] text-[32px] sm:text-[44px] font-[Anton] uppercase leading-none mb-3">
            Power Tools
          </h2>
          <p class="text-[var(--color-text-muted)] text-[14px] font-[Epilogue]">Level up your creation flow</p>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-5 max-w-5xl mx-auto reveal-stagger" id="tools-grid">
          {/* AI Prompt Tools Card */}
          <div class="glass-card p-6 sm:p-8 flex flex-col justify-between hover:!border-[var(--color-accent)]/30 group hover-tilt">
            <div>
              <div class="badge-pill badge-pill--active !bg-[var(--color-accent)]/10 !border-[var(--color-accent)]/30 !text-[var(--color-accent)] mb-4 w-fit">
                Creator Tools
              </div>
              <h3 class="font-[Epilogue] font-bold text-[20px] text-[var(--color-text)] mb-2 normal-case">Interactive AI Tools</h3>
              <p class="text-[var(--color-text-secondary)] text-[14px] font-[Epilogue] leading-relaxed mb-6">
                Optimize, generate, and extract prompts with ease.
              </p>
              <div class="space-y-2">
                {[
                  { href: "/tools/prompt-maker", name: "Prompt Maker", desc: "Visual style builder" },
                  { href: "/tools/prompt-enhancer", name: "Prompt Enhancer", desc: "Auto-polish for all models" },
                  { href: "/tools/image-to-prompt", name: "Image to Prompt", desc: "Extract prompts from images" },
                ].map((tool) => (
                  <a href={tool.href} class="flex items-center justify-between p-3 rounded-xl border border-[var(--color-border)] hover:border-[var(--color-border-hover)] hover:bg-white/[0.02] transition-all group/tool no-underline">
                    <div>
                      <p class="text-[13px] font-semibold text-[var(--color-text)] font-[Epilogue]">{tool.name}</p>
                      <p class="text-[11px] text-[var(--color-text-muted)] font-[Epilogue]">{tool.desc}</p>
                    </div>
                    <span class="text-[var(--color-text-muted)] group-hover/tool:text-[var(--color-accent)] group-hover/tool:translate-x-1 transition-all">→</span>
                  </a>
                ))}
              </div>
            </div>
            <a href="/tools" class="mt-6 inline-flex items-center justify-center gap-2 px-6 py-3 rounded-full bg-[var(--color-accent)] hover:bg-[var(--color-accent-hover)] text-white text-[13px] font-bold shadow-[0_4px_16px_var(--color-accent-glow)] hover:shadow-[0_8px_24px_var(--color-accent-glow)] transition-all duration-300 no-underline">
              Launch Toolkit →
            </a>
          </div>

          {/* Chrome Extension Card */}
          <div class="glass-card p-6 sm:p-8 flex flex-col justify-between hover:!border-[var(--color-secondary)]/30 group hover-tilt">
            <div>
              <div class="badge-pill badge-pill--active !bg-[var(--color-secondary)]/10 !border-[var(--color-secondary)]/30 !text-[var(--color-secondary)] mb-4 w-fit">
                Chrome Extension
              </div>
              <h3 class="font-[Epilogue] font-bold text-[20px] text-[var(--color-text)] mb-2 normal-case">Plug & Play Overlay</h3>
              <p class="text-[var(--color-text-secondary)] text-[14px] font-[Epilogue] leading-relaxed mb-6">
                Take Love4Prompts with you. Open our overlay inside ChatGPT, Gemini, Claude, or Midjourney and inject trending styles directly.
              </p>
              <div class="glass-card p-4 !bg-[var(--color-bg-glass)]">
                <div class="flex items-center gap-2 mb-2">
                  <span class="w-2.5 h-2.5 bg-[var(--color-success)] rounded-full pulse-ring"></span>
                  <span class="text-[11px] font-semibold text-[var(--color-text-secondary)] uppercase tracking-wider font-[Epilogue]">Active in browser</span>
                </div>
                <p class="text-[12px] text-[var(--color-text-muted)] leading-snug font-[Epilogue]">
                  No more tab-switching. Launch prompts directly inside the AI model's native UI.
                </p>
              </div>
            </div>
            <a href="/extension" class="mt-6 inline-flex items-center justify-center gap-2 px-6 py-3 rounded-full bg-[var(--color-secondary)] hover:brightness-110 text-white text-[13px] font-bold shadow-[0_4px_16px_rgba(251,113,133,0.25)] transition-all duration-300 no-underline">
              Install Extension →
            </a>
          </div>
        </div>
      </section>

    </main>
  </div>
</Layout>

{/* Scroll-reveal observer */}
<script>
  document.addEventListener('astro:page-load', () => {
    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            entry.target.classList.add('is-visible');
            observer.unobserve(entry.target);
          }
        });
      },
      { threshold: 0.15, rootMargin: '0px 0px -40px 0px' }
    );

    document.querySelectorAll('.reveal, .reveal-stagger').forEach((el) => {
      observer.observe(el);
    });
  });
</script>
