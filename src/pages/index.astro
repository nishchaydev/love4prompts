---
import Layout from '../components/layout/Layout.astro';
import { InteractiveLibrary } from '../components/library/InteractiveLibrary';
import { TestimonialSection } from '../components/marketing/TestimonialSection';
import { FeaturesGrid } from '../components/marketing/FeaturesGrid';
import { HowItWorks } from '../components/marketing/HowItWorks';
import { UniversalBar } from '../components/hero/UniversalBar';
import { PurpleWaveBackground } from '../components/layout/PurpleWaveBackground';
import { AnimatedSection } from '../components/ui/AnimatedSection';
import { supabase } from '../lib/supabase';
import type { Prompt } from '../components/library/PromptCard';
import { mockPrompts } from '../lib/mock-data';

const { data: dbPrompts, error } = await supabase
  .from('prompts')
  .select('*')
  .eq('is_public', true)
  .order('created_at', { ascending: false });

if (error) console.error('Error fetching prompts:', error);

const prompts = (dbPrompts && dbPrompts.length > 0) ? dbPrompts : mockPrompts;
const styles = Array.from(new Set(prompts?.map(p => p.style).filter(Boolean) || [])) as string[];

const title = "iloveprompts | All-in-One AI Prompt Platform — Enhance, Generate, Translate";
const description = "One bar. Every AI tool. Type what you need — enhance prompts, generate images, translate between AI models. Free. No signup. Works with ChatGPT, Midjourney, Claude, DALL-E, Gemini & Flux.";
---

<Layout title={title} description={description}>
  <div class="bg-transparent">

    {/* ═══ HERO ═══════════════════════════════════════════════════ */}
    <section class="relative min-h-dvh flex flex-col items-center justify-center px-4 pt-[80px] pb-20 overflow-hidden">
      <PurpleWaveBackground mode="hero" client:load />

      <div class="relative z-10 flex flex-col items-center text-center gap-7 w-full max-w-[860px] mx-auto animate-fade-in-up">

        {/* Badge */}
        <div class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full text-white/50 text-[12px] font-semibold tracking-wide"
          style="background: rgba(255,255,255,0.04); backdrop-filter: blur(20px); -webkit-backdrop-filter: blur(20px); border: 1px solid rgba(255,255,255,0.08); box-shadow: inset 0 1px 0 rgba(255,255,255,0.04);">
          <span class="w-1.5 h-1.5 rounded-full bg-[var(--color-primary)] shadow-[0_0_8px_var(--color-primary-glow)] animate-pulse"></span>
          All-in-One AI Prompt Platform
        </div>

        {/* H1 */}
        <h1 class="text-[clamp(44px,9vw,88px)] leading-[0.95] font-black tracking-[-0.04em]">
          <span class="text-white/95 block">One Bar.</span>
          <span class="block bg-gradient-to-r from-[#8B5CF6] via-[#D83F87] to-[#8B5CF6] bg-clip-text text-transparent [-webkit-background-clip:text] [-webkit-text-fill-color:transparent]">Every AI Tool.</span>
        </h1>

        {/* Sub */}
        <p class="text-[16px] sm:text-[17px] text-white/35 font-medium max-w-[460px] leading-relaxed -mt-1">
          Enhance prompts. Generate images. Translate between models.<br class="hidden sm:block" />
          Type what you need — we figure out the rest.
        </p>

        {/* UniversalBar */}
        <div class="w-full mt-1">
          <UniversalBar client:load />
        </div>

        {/* Stats */}
        <div class="flex flex-wrap items-center justify-center gap-6 text-[12px] font-semibold text-white/20 mt-2">
          <div class="flex items-center gap-2">
            <span class="w-1 h-1 rounded-full bg-emerald-400/60"></span>
            6 AI Tools
          </div>
          <div class="flex items-center gap-2">
            <span class="w-1 h-1 rounded-full bg-[var(--color-primary)]/60"></span>
            Free · No Signup
          </div>
          <div class="flex items-center gap-2">
            <span class="w-1 h-1 rounded-full bg-[#D83F87]/60"></span>
            Works with 6+ AI Models
          </div>
        </div>
      </div>
    </section>

    {/* ═══ WORKS WITH ═════════════════════════════════════════════ */}
    <div class="border-t border-b border-white/[0.04] overflow-hidden py-6"
      style="background: rgba(255,255,255,0.01); backdrop-filter: blur(10px); -webkit-backdrop-filter: blur(10px);">
      <div class="container mx-auto max-w-[1100px] px-4 flex flex-col md:flex-row items-center gap-6 justify-between">
        <p class="text-[11px] font-bold text-white/20 uppercase tracking-[0.15em] whitespace-nowrap">Works With</p>
        <div class="flex flex-wrap justify-center items-center gap-8 md:gap-12 opacity-30 hover:opacity-50 transition-opacity duration-500">
          <span class="text-[14px] font-bold text-white/60">ChatGPT</span>
          <span class="text-[14px] font-bold text-white/60">Midjourney</span>
          <span class="text-[14px] font-bold text-white/60">DALL·E</span>
          <span class="text-[14px] font-bold text-white/60">Claude</span>
          <span class="text-[14px] font-bold text-white/60">Gemini</span>
          <span class="text-[14px] font-bold text-white/60">Flux</span>
        </div>
      </div>
    </div>

    {/* ═══ FEATURES (Glassmorphism + Framer Motion) ═════════════ */}
    <FeaturesGrid client:visible />

    {/* ═══ HOW IT WORKS (Framer Motion scroll reveals) ══════════ */}
    <HowItWorks client:visible />

    {/* ═══ TESTIMONIALS ═══════════════════════════════════════════ */}
    <TestimonialSection />

    {/* ═══ LIBRARY ════════════════════════════════════════════════ */}
    <section class="pb-24" id="library">
      <AnimatedSection client:visible className="container mx-auto px-4 pt-20 mb-6 border-t border-white/[0.04] text-center">
        <p class="text-[11px] font-bold text-[var(--color-primary)] uppercase tracking-[0.2em] mb-3">Explore</p>
        <h2 class="text-3xl md:text-[40px] font-black text-white tracking-[-0.03em]">The Prompt Library</h2>
        <p class="text-white/25 font-medium mt-2 text-[14px]">
          Curated prompts across all categories — copy any, use instantly
        </p>
      </AnimatedSection>
      <div class="container mx-auto px-4">
        <InteractiveLibrary client:load prompts={prompts as Prompt[]} styles={styles} />
      </div>
    </section>
  </div>
</Layout>
