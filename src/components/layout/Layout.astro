---
import '../../styles/global.css';
import { ClientRouter } from 'astro:transitions';
import { Header } from './Header';
import { EditorialFooter } from './EditorialFooter';
import { TrendingBar } from './TrendingBar';

interface Props {
  title: string;
  description: string;
  ogImage?: string;
  canonicalUrl?: string;
}

const { 
  title, 
  description, 
  ogImage = '/default-og.png',
  canonicalUrl = Astro.url.href,
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=5.0" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <ClientRouter fallback="swap" />
    
    <!-- Canonical URL -->
    <link rel="canonical" href={canonicalUrl} />

    <!-- Open Graph -->
    <meta property="og:site_name" content="Love4Prompts" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={new URL(ogImage, Astro.site || 'https://love4prompts.com').href} />
    <meta property="og:url" content={canonicalUrl} />
    
    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={new URL(ogImage, Astro.site || 'https://love4prompts.com').href} />

    <!-- Theme Color & PWA -->
    <meta name="theme-color" content="#0A0A0F" />
    <meta name="apple-mobile-web-app-capable" content="yes" />

    <!-- JSON-LD Schema -->
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@graph": [
        {
          "@type": "WebSite",
          "@id": "https://love4prompts.com/#website",
          "url": "https://love4prompts.com/",
          "name": "Love4Prompts",
          "description": "The fastest way to recreate viral AI image trends. Discover trending AI styles, copy the prompt, and launch directly into ChatGPT, Gemini or Claude.",
          "publisher": {
            "@type": "Organization",
            "name": "Love4Prompts",
            "logo": {
              "@type": "ImageObject",
              "url": "https://love4prompts.com/logo-icon.png"
            }
          }
        },
        {
          "@type": "WebApplication",
          "@id": "https://love4prompts.com/#webapp",
          "name": "Love4Prompts",
          "description": "See the Trend. Be the Trend. The fastest platform to discover, recreate and use viral AI image trends in seconds.",
          "applicationCategory": "DesignApplication",
          "operatingSystem": "All",
          "browserRequirements": "Requires JavaScript. Requires HTML5.",
          "offers": {
            "@type": "Offer",
            "price": "0",
            "priceCurrency": "USD"
          }
        }
      ]
    })} />

    <!-- Fonts: Anton (display) + Epilogue (body) + JetBrains Mono -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Anton&family=Epilogue:wght@400;500;600;700&family=JetBrains+Mono:wght@400&display=swap" rel="stylesheet" />

    <!-- Microsoft Clarity - Session Recording & Heatmaps -->
    <script type="text/javascript">
      (function(c,l,a,r,i,t,y){
        c[a]=c[a]||function(){(c[a].q=c[a].q||[]).push(arguments)};
        t=l.createElement(r);t.async=1;t.src="https://www.clarity.ms/tag/"+i;
        y=l.getElementsByTagName(r)[0];y.parentNode.insertBefore(t,y);
      })(window, document, "clarity", "script", "x3b15mgjik");
    </script>

    <!-- Google AdSense -->
    {import.meta.env.PUBLIC_ADSENSE_ID && (
      <>
        <meta name="google-adsense-account" content={import.meta.env.PUBLIC_ADSENSE_ID} />
        <script is:inline async src={`https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=${import.meta.env.PUBLIC_ADSENSE_ID}`} crossorigin="anonymous"></script>
      </>
    )}
  </head>
  <body class="min-h-screen flex flex-col w-full relative bg-[var(--color-bg)] text-[var(--color-text)] selection:bg-[var(--color-primary)] selection:text-white">

    <!-- Top Progress Bar for ViewTransitions -->
    <div id="nav-progress" role="progressbar" aria-valuemin="0" aria-valuemax="100" aria-valuenow="0" class="fixed top-0 left-0 h-[3px] z-[999999] w-0 transition-all duration-300 ease-out opacity-0 pointer-events-none rounded-r-full" style="background: linear-gradient(90deg, var(--color-primary), var(--color-secondary));"></div>

    <!-- Splash Loader -->
    <div id="global-splash-loader" class="fixed inset-0 z-[99999] flex flex-col items-center justify-center bg-[var(--color-bg)] transition-opacity duration-500 ease-out pointer-events-none opacity-0">
      <div class="flex flex-col items-center gap-4 animate-pulse">
        <span class="font-[Anton] uppercase tracking-wide" style="font-size: clamp(32px, 8vw, 56px); line-height: 1;">
          <span class="text-[var(--color-text)]">love4</span><span class="text-[var(--color-primary)]">prompts</span>
        </span>
        <div class="w-16 h-[2px] bg-[var(--color-primary)] rounded-full"></div>
      </div>
    </div>

    <!-- Subtle Noise Texture Overlay -->
    <svg class="pointer-events-none fixed inset-0 z-[9999] h-full w-full opacity-[0.03] mix-blend-overlay" style="isolation: isolate;" aria-hidden="true">
      <filter id="noiseFilter">
        <feTurbulence type="fractalNoise" baseFrequency="0.8" numOctaves="3" stitchTiles="stitch" />
      </filter>
      <rect width="100%" height="100%" filter="url(#noiseFilter)" />
    </svg>

    <!-- Ambient Gradient Mesh Background -->
    <div class="absolute top-0 inset-x-0 h-[800px] overflow-hidden pointer-events-none z-0 opacity-[0.30]" aria-hidden="true">
      <div class="absolute top-[-15%] left-[10%] w-[80vw] max-w-[700px] h-[500px] rounded-full bg-[var(--color-primary)] opacity-[0.25] blur-[140px]"></div>
      <div class="absolute top-[5%] left-[55%] w-[60vw] max-w-[500px] h-[400px] rounded-full bg-[var(--color-secondary)] opacity-[0.18] blur-[120px]"></div>
      <div class="absolute top-[-10%] left-[40%] w-[55vw] max-w-[450px] h-[350px] rounded-full bg-[var(--color-accent)] opacity-[0.12] blur-[110px]"></div>
    </div>

    <div class="relative z-10 flex flex-col min-h-screen w-full">
      <Header client:load currentPath={Astro.url.pathname} />
      <TrendingBar client:load />
      <main class="flex-1">
        <slot />
      </main>
      <EditorialFooter />
    </div>

    <!-- Physics Engine for Micro-Interactions -->
    <script is:inline>
      (function() {
        if (typeof window !== 'undefined' && !window._physicsAttached) {
          window._physicsAttached = true;

          // --- Progress Bar for ViewTransitions ---
          document.addEventListener('astro:before-preparation', () => {
            const bar = document.getElementById('nav-progress');
            if (bar) {
              bar.style.transition = 'width 0.3s ease-out, opacity 0.1s';
              bar.style.opacity = '1';
              bar.style.width = '30%';
              bar.setAttribute('aria-valuenow', '30');
              window._navInterval = setInterval(() => {
                const current = parseInt(bar.style.width || '30');
                if (current < 85) {
                  const next = current + 5;
                  bar.style.width = next + '%';
                  bar.setAttribute('aria-valuenow', next.toString());
                }
              }, 200);
            }
          });

          document.addEventListener('astro:page-load', () => {
            const bar = document.getElementById('nav-progress');
            if (bar) {
              clearInterval(window._navInterval);
              bar.style.width = '100%';
              bar.setAttribute('aria-valuenow', '100');
              setTimeout(() => {
                bar.style.opacity = '0';
                setTimeout(() => {
                  bar.style.transition = 'none';
                  bar.style.width = '0';
                  bar.setAttribute('aria-valuenow', '0');
                }, 300);
              }, 300);
            }
          });

          // --- Sparkle Click Effect ---
          document.addEventListener('click', (e) => {
            const colors = ['var(--color-primary)', 'var(--color-secondary)', 'var(--color-accent)'];
            const spark = document.createElement('div');
            spark.className = 'click-sparkle';
            spark.style.left = e.clientX + 'px';
            spark.style.top = e.clientY + 'px';
            document.body.appendChild(spark);
            
            for (let i = 0; i < 5; i++) {
              const ray = document.createElement('div');
              ray.className = 'sparkle-ray';
              ray.style.backgroundColor = colors[Math.floor(Math.random() * colors.length)];
              ray.style.setProperty('--rot', `${(i * 72)}deg`);
              spark.appendChild(ray);
            }
            setTimeout(() => spark.remove(), 400);
          }, true);

          // --- Spring Physics for Magnetic Buttons ---
          let magneticBtns = new Set();
          let isRunning = false;
          let rafId = null;

          function startPhysics() {
            if (!isRunning) { isRunning = true; physicsLoop(); }
          }
          function stopPhysics() {
            isRunning = false;
            if (rafId) { cancelAnimationFrame(rafId); rafId = null; }
          }

          function physicsLoop() {
            if (!isRunning) return;
            let anyMoving = false;
            magneticBtns.forEach(btn => {
              if (!btn._spring) return;
              const s = btn._spring;
              const ax = (s.targetX - s.x) * s.stiffness;
              const ay = (s.targetY - s.y) * s.stiffness;
              s.vx += ax; s.vy += ay;
              s.vx *= s.damping; s.vy *= s.damping;
              s.x += s.vx; s.y += s.vy;
              const isMoving = Math.abs(s.vx) > 0.01 || Math.abs(s.targetX - s.x) > 0.01 ||
                  Math.abs(s.vy) > 0.01 || Math.abs(s.targetY - s.y) > 0.01;
              if (isMoving) {
                btn.style.transform = `translate(${s.x}px, ${s.y}px)`;
                anyMoving = true;
              }
            });
            if (anyMoving) { rafId = requestAnimationFrame(physicsLoop); }
            else { stopPhysics(); }
          }

          const applyMagnetic = () => {
            const btns = document.querySelectorAll('.magnetic-btn');
            btns.forEach(btn => {
              if (btn._magneticAttached) return;
              btn._magneticAttached = true;
              magneticBtns.add(btn);
              btn._spring = { x: 0, y: 0, vx: 0, vy: 0, targetX: 0, targetY: 0, stiffness: 0.15, damping: 0.75 };
              btn.addEventListener('mousemove', (e) => {
                const rect = btn.getBoundingClientRect();
                btn._spring.targetX = (e.clientX - rect.left - rect.width / 2) * 0.3;
                btn._spring.targetY = (e.clientY - rect.top - rect.height / 2) * 0.3;
                startPhysics();
              });
              btn.addEventListener('mouseleave', () => {
                btn._spring.targetX = 0; btn._spring.targetY = 0;
                startPhysics();
              });
            });
          };
          
          applyMagnetic();
          document.addEventListener('astro:page-load', applyMagnetic);
        }
      })();
    </script>

    <!-- Splash Loader Script -->
    <script>
      let loaderHidden = false;
      let fallbackTimeout = 0;
      
      const hideLoader = () => {
        if (loaderHidden) return;
        loaderHidden = true;
        if (fallbackTimeout) clearTimeout(fallbackTimeout);
        const loader = document.getElementById('global-splash-loader');
        if (loader) {
          setTimeout(() => {
            loader.style.opacity = '0';
            loader.style.pointerEvents = 'none';
            setTimeout(() => {
              document.body.classList.remove('loading-locked');
              window.removeEventListener('load', hideLoader);
              document.removeEventListener('astro:page-load', hideLoader);
            }, 500);
          }, 600);
        }
      };
      window.addEventListener('load', hideLoader);
      document.addEventListener('astro:page-load', hideLoader);
      fallbackTimeout = window.setTimeout(hideLoader, 3000);
    </script>

    <style is:global>
      .click-sparkle {
        position: fixed;
        pointer-events: none;
        z-index: 9999999;
        transform: translate(-50%, -50%);
      }
      .sparkle-ray {
        position: absolute;
        width: 4px;
        height: 10px;
        border-radius: 2px;
        top: 50%;
        left: 50%;
        transform-origin: 50% 100%;
        animation: burst 0.35s cubic-bezier(0.1, 0.8, 0.3, 1) forwards;
      }
      @keyframes burst {
        0% {
          transform: translate(-50%, -100%) rotate(var(--rot)) translateY(-4px) scale(1);
          opacity: 0.8;
        }
        40% { opacity: 0.8; }
        100% {
          transform: translate(-50%, -100%) rotate(var(--rot)) translateY(-24px) scale(0);
          opacity: 0;
        }
      }
    </style>
  </body>
</html>
