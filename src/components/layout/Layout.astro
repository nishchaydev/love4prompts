---
import '../../styles/global.css';
import { Header } from './Header';
import { SeoFooter } from './SeoFooter';
import { TrendingBar } from './TrendingBar';

interface Props {
  title: string;
  description: string;
  ogImage?: string;
  canonicalUrl?: string;
}

const { 
  title, 
  description, 
  ogImage = '/default-og.png',
  canonicalUrl = Astro.url.href 
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <title>{title}</title>
    <meta name="description" content={description} />
    
    <!-- Canonical URL -->
    <link rel="canonical" href={canonicalUrl} />

    <!-- Open Graph -->
    <meta property="og:site_name" content="Love4Prompts" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={new URL(ogImage, Astro.site || 'https://love4prompts.com').href} />
    <meta property="og:url" content={canonicalUrl} />
    
    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={new URL(ogImage, Astro.site || 'https://love4prompts.com').href} />

    <!-- Theme Color & PWA -->
    <meta name="theme-color" content="#120A24" />
    <meta name="apple-mobile-web-app-capable" content="yes" />

    <!-- JSON-LD Schema -->
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@graph": [
        {
          "@type": "WebSite",
          "@id": "https://love4prompts.com/#website",
          "url": "https://love4prompts.com/",
          "name": "Love4Prompts",
          "description": "The ultimate prompt toolkit for every AI. Generate, enhance, and translate AI prompts instantly.",
          "publisher": {
            "@type": "Organization",
            "name": "Love4Prompts",
            "logo": {
              "@type": "ImageObject",
              "url": "https://love4prompts.com/logo-icon.png"
            }
          }
        },
        {
          "@type": "SoftwareApplication",
          "@id": "https://love4prompts.com/#software",
          "name": title,
          "description": description,
          "applicationCategory": "UtilitiesApplication",
          "operatingSystem": "All",
          "offers": {
            "@type": "Offer",
            "price": "0",
            "priceCurrency": "USD"
          }
        }
      ]
    })} />

    <!-- Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=Outfit:wght@400;500;600;700;800;900&family=JetBrains+Mono:wght@400&display=swap" rel="stylesheet" />

    <!-- Microsoft Clarity - Session Recording & Heatmaps -->
    <script type="text/javascript">
      (function(c,l,a,r,i,t,y){
        c[a]=c[a]||function(){(c[a].q=c[a].q||[]).push(arguments)};
        t=l.createElement(r);t.async=1;t.src="https://www.clarity.ms/tag/"+i;
        y=l.getElementsByTagName(r)[0];y.parentNode.insertBefore(t,y);
      })(window, document, "clarity", "script", "x3b15mgjik");
    </script>
  </head>
  <body class="min-h-screen flex flex-col bg-[var(--color-background-primary)] text-[var(--color-text-primary)] selection:bg-[var(--color-primary)] selection:text-white overflow-x-hidden">
    
    <!-- Atmospheric Organic Gradient Mesh Backdrop (Stripi + Wope inspired) -->
    <div class="absolute top-0 inset-x-0 h-[700px] overflow-hidden pointer-events-none z-0 opacity-[0.35]" aria-hidden="true">
      <!-- Deep Purple/Indigo Glow Base -->
      <div class="absolute top-[-15%] left-[10%] w-[80vw] max-w-[700px] h-[500px] rounded-full bg-[#713DFF] opacity-[0.35] blur-[130px]"></div>
      <!-- Ruby Pink Blob -->
      <div class="absolute top-[5%] left-[55%] w-[60vw] max-w-[500px] h-[400px] rounded-full bg-[#ea2261] opacity-[0.22] blur-[110px]"></div>
      <!-- Sherbet Orange Blob -->
      <div class="absolute top-[-20%] left-[40%] w-[55vw] max-w-[450px] h-[350px] rounded-full bg-[#ff9f43] opacity-[0.18] blur-[100px]"></div>
      <!-- Lavender/Blue Blob -->
      <div class="absolute top-[8%] left-[25%] w-[65vw] max-w-[550px] h-[400px] rounded-full bg-[#b9b9f9] opacity-[0.15] blur-[120px]"></div>
      <!-- Warm Cream Accent Blob -->
      <div class="absolute top-[-5%] left-[65%] w-[50vw] max-w-[400px] h-[300px] rounded-full bg-[#faf0e6] opacity-[0.1] blur-[90px]"></div>
    </div>

    <div class="relative z-10 flex flex-col min-h-screen">
      <Header client:load />
      <TrendingBar client:load />
      <main class="flex-1">
        <slot />
      </main>
      <SeoFooter />
    </div>
  </body>
</html>
