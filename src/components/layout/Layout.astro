---
import '../../styles/global.css';
import { Header } from './Header';
import { SeoFooter } from './SeoFooter';
import { TrendingBar } from './TrendingBar';

interface Props {
  title: string;
  description: string;
  ogImage?: string;
  canonicalUrl?: string;
}

const { 
  title, 
  description, 
  ogImage = '/default-og.png',
  canonicalUrl = Astro.url.href 
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    
    <!-- Canonical URL -->
    <link rel="canonical" href={canonicalUrl} />

    <!-- Open Graph -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:url" content={canonicalUrl} />
    
    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />

    <!-- Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=Outfit:wght@400;500;600;700;800;900&family=JetBrains+Mono:wght@400&display=swap" rel="stylesheet" />
  </head>
  <body class="min-h-screen flex flex-col bg-[var(--color-background-primary)] text-[var(--color-text-primary)] selection:bg-[var(--color-primary)] selection:text-white">
    
    <!-- Atmospheric Organic Gradient Mesh Backdrop (Stripi + Wope inspired) -->
    <div class="absolute top-0 inset-x-0 h-[700px] overflow-hidden pointer-events-none z-0 opacity-[0.35]" aria-hidden="true">
      <!-- Deep Purple/Indigo Glow Base -->
      <div class="absolute top-[-15%] left-[10%] w-[700px] h-[500px] rounded-full bg-[#713DFF] opacity-[0.35] blur-[130px]"></div>
      <!-- Ruby Pink Blob -->
      <div class="absolute top-[5%] left-[55%] w-[500px] h-[400px] rounded-full bg-[#ea2261] opacity-[0.22] blur-[110px]"></div>
      <!-- Sherbet Orange Blob -->
      <div class="absolute top-[-20%] left-[40%] w-[450px] h-[350px] rounded-full bg-[#ff9f43] opacity-[0.18] blur-[100px]"></div>
      <!-- Lavender/Blue Blob -->
      <div class="absolute top-[8%] left-[25%] w-[550px] h-[400px] rounded-full bg-[#b9b9f9] opacity-[0.15] blur-[120px]"></div>
      <!-- Warm Cream Accent Blob -->
      <div class="absolute top-[-5%] left-[65%] w-[400px] h-[300px] rounded-full bg-[#faf0e6] opacity-[0.1] blur-[90px]"></div>
    </div>

    <div class="relative z-10 flex flex-col min-h-screen">
      <Header client:load />
      <TrendingBar client:load />
      <main class="flex-1">
        <slot />
      </main>
      <SeoFooter />
    </div>
  </body>
</html>
