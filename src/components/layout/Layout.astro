---
import '../../styles/global.css';
import { ClientRouter } from 'astro:transitions';
import { Header } from './Header';
import { SeoFooter } from './SeoFooter';
import { EditorialFooter } from './EditorialFooter';
import { TrendingBar } from './TrendingBar';
import { PaperAirplaneAd } from '../ads/PaperAirplaneAd';
import { AdSlot } from '../ads/AdSlot';

interface Props {
  title: string;
  description: string;
  ogImage?: string;
  canonicalUrl?: string;
  theme?: 'default' | 'editorial';
}

const { 
  title, 
  description, 
  ogImage = '/default-og.png',
  canonicalUrl = Astro.url.href,
  theme = 'editorial'
} = Astro.props;

const isEditorial = theme === 'editorial';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=5.0" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <ClientRouter fallback="swap" />
    
    <!-- Canonical URL -->
    <link rel="canonical" href={canonicalUrl} />

    <!-- Open Graph -->
    <meta property="og:site_name" content="Love4Prompts" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={new URL(ogImage, Astro.site || 'https://love4prompts.com').href} />
    <meta property="og:url" content={canonicalUrl} />
    
    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={new URL(ogImage, Astro.site || 'https://love4prompts.com').href} />

    <!-- Theme Color & PWA -->
    <meta name="theme-color" content="#120A24" />
    <meta name="apple-mobile-web-app-capable" content="yes" />

    <!-- JSON-LD Schema -->
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@graph": [
        {
          "@type": "WebSite",
          "@id": "https://love4prompts.com/#website",
          "url": "https://love4prompts.com/",
          "name": "Love4Prompts",
          "description": "The ultimate prompt toolkit for every AI. Generate, enhance, and translate AI prompts instantly.",
          "publisher": {
            "@type": "Organization",
            "name": "Love4Prompts",
            "logo": {
              "@type": "ImageObject",
              "url": "https://love4prompts.com/logo-icon.png"
            }
          }
        },
        {
          "@type": "SoftwareApplication",
          "@id": "https://love4prompts.com/#software",
          "name": title,
          "description": description,
          "applicationCategory": "UtilitiesApplication",
          "operatingSystem": "All",
          "offers": {
            "@type": "Offer",
            "price": "0",
            "priceCurrency": "USD"
          }
        }
      ]
    })} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Outfit:wght@400;500;600;700;800;900&family=JetBrains+Mono:wght@400&display=swap" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap" rel="stylesheet" />

    <!-- Microsoft Clarity - Session Recording & Heatmaps -->
    <script type="text/javascript">
      (function(c,l,a,r,i,t,y){
        c[a]=c[a]||function(){(c[a].q=c[a].q||[]).push(arguments)};
        t=l.createElement(r);t.async=1;t.src="https://www.clarity.ms/tag/"+i;
        y=l.getElementsByTagName(r)[0];y.parentNode.insertBefore(t,y);
      })(window, document, "clarity", "script", "x3b15mgjik");
    </script>

    <!-- Google AdSense -->
    <meta name="google-adsense-account" content={import.meta.env.PUBLIC_ADSENSE_ID || 'ca-pub-2577531019319172'} />
    <script is:inline async src={`https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=${import.meta.env.PUBLIC_ADSENSE_ID || 'ca-pub-2577531019319172'}`} crossorigin="anonymous"></script>
  </head>
  <body 
    class:list={[
    'min-h-screen flex flex-col w-full relative',
    isEditorial
      ? 'editorial-page bg-[#FAEFED] text-[#1a1a1a] selection:bg-[#FF6D87] selection:text-white'
      : 'bg-[var(--color-background-primary)] text-[var(--color-text-primary)] selection:bg-[var(--color-primary)] selection:text-white'
  ]}>

    <!-- Global Splash Loader -->
    <div id="global-splash-loader" class="fixed inset-0 z-[99999] flex flex-col items-center justify-center bg-[#FAEFED] transition-opacity duration-500 ease-out pointer-events-none opacity-0">
      <div class="flex items-center justify-center animate-pulse">
        <span class="font-black tracking-tighter uppercase" style="font-family: 'Inter', sans-serif; font-size: clamp(32px, 8vw, 64px); line-height: 1;">
          <span class="text-black">love4</span><span class="text-[#FF6D87]">prompts</span>
        </span>
      </div>
    </div>

    <!-- Premium Noise/Grain Overlay -->
    <svg class="pointer-events-none fixed inset-0 z-[9999] h-full w-full opacity-[0.2] mix-blend-overlay" style="isolation: isolate;">
      <filter id="noiseFilter">
        <feTurbulence type="fractalNoise" baseFrequency="0.8" numOctaves="3" stitchTiles="stitch" />
      </filter>
      <rect width="100%" height="100%" filter="url(#noiseFilter)" />
    </svg>
    
    <style is:global>
      body.loading-locked {
        overflow: hidden;
      }
      
      @keyframes grid-pan {
        0% { background-position: 0 0; }
        100% { background-position: 40px 40px; }
      }
      .animate-grid-pan {
        animation: grid-pan 30s linear infinite;
      }
    </style>

    <script>
      // Make it visible immediately on initial load if we don't have ViewTransitions history
      // Removed to improve LCP (Largest Contentful Paint)


      // Hide loader function
      let loaderHidden = false;
      let fallbackTimeout = 0;
      
      const hideLoader = () => {
        if (loaderHidden) return;
        loaderHidden = true;
        if (fallbackTimeout) clearTimeout(fallbackTimeout);

        const loader = document.getElementById('global-splash-loader');
        if (loader) {
          // Add a short delay so the user sees the loader, then fade out
          setTimeout(() => {
            loader.style.opacity = '0';
            loader.style.pointerEvents = 'none';
            setTimeout(() => {
              document.body.classList.remove('loading-locked');
              window.removeEventListener('load', hideLoader);
              document.removeEventListener('astro:page-load', hideLoader);
            }, 500); // match transition duration
          }, 800);
        }
      };

      // Initial page load
      window.addEventListener('load', hideLoader);
      
      // Astro ViewTransitions: Hide loader after new page swaps in
      document.addEventListener('astro:page-load', hideLoader);

      // Safety fallback
      fallbackTimeout = window.setTimeout(hideLoader, 4000);
    </script>
    
    {!isEditorial && (
      <div class="absolute top-0 inset-x-0 h-[700px] overflow-hidden pointer-events-none z-0 opacity-[0.35]" aria-hidden="true">
        <div class="absolute top-[-15%] left-[10%] w-[80vw] max-w-[700px] h-[500px] rounded-full bg-[var(--color-accent-violet)] opacity-[0.35] blur-[130px]"></div>
        <div class="absolute top-[5%] left-[55%] w-[60vw] max-w-[500px] h-[400px] rounded-full bg-[#ea2261] opacity-[0.22] blur-[110px]"></div>
        <div class="absolute top-[-20%] left-[40%] w-[55vw] max-w-[450px] h-[350px] rounded-full bg-[#ff9f43] opacity-[0.18] blur-[100px]"></div>
        <div class="absolute top-[8%] left-[25%] w-[65vw] max-w-[550px] h-[400px] rounded-full bg-[#b9b9f9] opacity-[0.15] blur-[120px]"></div>
        <div class="absolute top-[-5%] left-[65%] w-[50vw] max-w-[400px] h-[300px] rounded-full bg-[#faf0e6] opacity-[0.1] blur-[90px]"></div>
      </div>
    )}

    {isEditorial && (
      <div 
        class="fixed inset-0 z-0 pointer-events-none opacity-[0.4] animate-grid-pan" 
        style={{
          backgroundImage: `
            linear-gradient(to right, #cfc4c5 1px, transparent 1px),
            linear-gradient(to bottom, #cfc4c5 1px, transparent 1px)
          `,
          backgroundSize: '40px 40px',
          backgroundPosition: '0 0'
        }}
      ></div>
    )}

    <div class:list={['relative z-10 flex flex-col min-h-screen w-full', isEditorial ? '' : '']}>
      <Header client:load isEditorial={isEditorial} currentPath={Astro.url.pathname} />
      {!isEditorial && <TrendingBar client:load />}
      {isEditorial ? (
        <div class="flex-1 flex flex-col w-full mt-20">
          <slot />
        </div>
      ) : (
        <main class="flex-1">
          <slot />
        </main>
      )}
      {isEditorial ? <EditorialFooter /> : <SeoFooter />}
    </div>

    {/* Physics Engine for Micro-Interactions */}
    <script is:inline>
      (function() {
        // --- Particle Physics (Gravity & Drag) ---
        const particles = [];
        const GRAVITY = 0.6;
        const DRAG = 0.92;
        
        if (typeof window !== 'undefined' && !window._physicsAttached) {
          window._physicsAttached = true;
          
          document.addEventListener('click', (e) => {
            // Ignore clicks on links/buttons to prevent blocking them, but still spawn particles
            const colors = ['#000000', '#000000', '#000000', '#FF6D87', '#1482A3'];


            // 2. Sparkle Rays (High Energy Burst)
            const spark = document.createElement('div');
            spark.className = 'click-sparkle';
            spark.style.left = e.clientX + 'px';
            spark.style.top = e.clientY + 'px';
            document.body.appendChild(spark);
            
            // Create 5 rays in a burst
            for(let i = 0; i < 5; i++) {
              const ray = document.createElement('div');
              ray.className = 'sparkle-ray';
              ray.style.backgroundColor = colors[Math.floor(Math.random() * colors.length)];
              ray.style.setProperty('--rot', `${(i * 72)}deg`);
              spark.appendChild(ray);
            }

            setTimeout(() => spark.remove(), 400);

          }, true);

          let magneticBtns = new Set();
          let isRunning = false;
          let rafId = null;

          function startPhysics() {
            if (!isRunning) {
              isRunning = true;
              physicsLoop();
            }
          }

          function stopPhysics() {
            isRunning = false;
            if (rafId) {
              cancelAnimationFrame(rafId);
              rafId = null;
            }
          }

          // Physics Loop for Magnetic Buttons
          function physicsLoop() {
            if (!isRunning) return;
            
            let anyMoving = false;
            // Update Springs (Magnetic Buttons)
            magneticBtns.forEach(btn => {
              if (!btn._spring) return;
              const s = btn._spring;
              
              // Hooke's Law: F = -kx - cv
              const ax = (s.targetX - s.x) * s.stiffness;
              const ay = (s.targetY - s.y) * s.stiffness;
              
              s.vx += ax;
              s.vy += ay;
              s.vx *= s.damping;
              s.vy *= s.damping;
              s.x += s.vx;
              s.y += s.vy;
              
              const isMoving = Math.abs(s.vx) > 0.01 || Math.abs(s.targetX - s.x) > 0.01 ||
                  Math.abs(s.vy) > 0.01 || Math.abs(s.targetY - s.y) > 0.01;
              
              if (isMoving) {
                btn.style.transform = `translate(${s.x}px, ${s.y}px)`;
                anyMoving = true;
              }
            });

            if (anyMoving) {
              rafId = requestAnimationFrame(physicsLoop);
            } else {
              stopPhysics();
            }
          }

          // --- Spring Physics for Magnetic Buttons ---
          const applyMagnetic = () => {
            const btns = document.querySelectorAll('.magnetic-btn');
            btns.forEach(btn => {
              if (btn._magneticAttached) return;
              btn._magneticAttached = true;
              magneticBtns.add(btn);
              
              // Initialize spring state
              btn._spring = {
                x: 0, y: 0,
                vx: 0, vy: 0,
                targetX: 0, targetY: 0,
                stiffness: 0.15, // Tension
                damping: 0.75    // Friction
              };

              btn.addEventListener('mousemove', (e) => {
                const rect = btn.getBoundingClientRect();
                const x = e.clientX - rect.left - rect.width / 2;
                const y = e.clientY - rect.top - rect.height / 2;
                
                btn._spring.targetX = x * 0.3;
                btn._spring.targetY = y * 0.3;
                startPhysics();
              });
              
              btn.addEventListener('mouseleave', () => {
                btn._spring.targetX = 0;
                btn._spring.targetY = 0;
                startPhysics();
              });
            });
          };
          
          applyMagnetic();
          document.addEventListener('astro:page-load', applyMagnetic);
        }
      })();
    </script>
    <style is:global>
      .click-sparkle {
        position: fixed;
        pointer-events: none;
        z-index: 9999999;
        transform: translate(-50%, -50%);
      }
      .sparkle-ray {
        position: absolute;
        width: 6px;
        height: 14px;
        border-radius: 2px;
        top: 50%;
        left: 50%;
        transform-origin: 50% 100%;
        animation: burst 0.4s cubic-bezier(0.1, 0.8, 0.3, 1) forwards;
      }
      @keyframes burst {
        0% {
          transform: translate(-50%, -100%) rotate(var(--rot)) translateY(-4px) scale(1);
          opacity: 1;
        }
        40% {
          opacity: 1;
        }
        100% {
          transform: translate(-50%, -100%) rotate(var(--rot)) translateY(-28px) scale(0);
          opacity: 0;
        }
      }
    </style>
    <PaperAirplaneAd client:load />
  </body>
</html>
